    <Item class="ModuleScript" referent="RBX0102">
      <Properties>
        <string name="Name">SMBWorld</string>
        <ProtectedString name="Source">--!nonstrict
-- Source-driven SMB1Base world/area decoder.
-- Area object bytes and enemy bytes are decoded from SMBData, not hand-authored maps.
local Data = require(script.Parent:WaitForChild("SMBData"))

local World = {}
local AREA_BASE = { 0, 3, 25, 28 }
local ENEMY_BASE = { 31, 6, 28, 0 }
local AREA_TYPE_NAMES = { "water", "ground", "underground", "castle" }
local AREA_TERRAIN = { 0x69, 0x54, 0x52, 0x62 }
local AREA_BRICK = { 0x22, 0x51, 0x52, 0x52 }
local AREA_SOLID = { 0x69, 0x61, 0x61, 0x62 }
local AREA_COIN = { 0xC3, 0xC2, 0xC2, 0xC2 }
local BACK_OFFSETS = { 0, 0x30, 0x60 }
local FORE_OFFSETS = { 0, 0x0D, 0x1A }
local PIPE_INTRO_POINTER = 0x29

local QUESTION_TILES = { 0xC1, 0xC0, 0x5F, 0x60 }
local GROUND_BRICKS = { 0x55, 0x56, 0x57, 0x58, 0x59 }
local OTHER_BRICKS = { 0x5A, 0x5B, 0x5C, 0x5D, 0x5E }
local CASTLE = {
	{ 0x00, 0x45, 0x45, 0x45, 0x00 },
	{ 0x00, 0x48, 0x47, 0x46, 0x00 },
	{ 0x45, 0x49, 0x49, 0x49, 0x45 },
	{ 0x47, 0x47, 0x4A, 0x47, 0x47 },
	{ 0x47, 0x47, 0x4B, 0x47, 0x47 },
	{ 0x49, 0x49, 0x49, 0x49, 0x49 },
	{ 0x47, 0x4A, 0x47, 0x4A, 0x47 },
	{ 0x47, 0x4B, 0x47, 0x4B, 0x47 },
	{ 0x47, 0x47, 0x47, 0x47, 0x47 },
	{ 0x4A, 0x47, 0x4A, 0x47, 0x4A },
	{ 0x4B, 0x47, 0x4B, 0x47, 0x4B },
}

local VALID_ENEMIES = {
	[0x00] = true, [0x02] = true, [0x03] = true, [0x05] = true,
	[0x06] = true, [0x07] = true, [0x08] = true, [0x0A] = true,
	[0x0B] = true, [0x0C] = true, [0x0D] = true, [0x0E] = true,
	[0x0F] = true, [0x10] = true, [0x11] = true, [0x12] = true,
	[0x14] = true, [0x15] = true, [0x16] = true, [0x17] = true,
	[0x18] = true, [0x2D] = true,
}

local function areaLabel(pointer)
	local areaType = bit32.band(bit32.rshift(pointer, 5), 0x03)
	local low = bit32.band(pointer, 0x1F)
	local index = AREA_BASE[areaType + 1] + low + 1
	return Data.AreaOrder[index], areaType
end

local function enemyLabel(pointer)
	local areaType = bit32.band(bit32.rshift(pointer, 5), 0x03)
	local low = bit32.band(pointer, 0x1F)
	local index = ENEMY_BASE[areaType + 1] + low + 1
	return Data.EnemyOrder[index]
end

local function blankColumn()
	return table.create(13, 0)
end

local function blankMetadataColumn()
	return table.create(13)
end

local function getCell(map, x, row)
	if x &lt; 0 or x &gt;= #map or row &lt; 0 or row &gt;= 13 then
		return 0
	end
	return map[x + 1][row + 1] or 0
end

local function put(map, width, x, row, tile, overwrite)
	if x &lt; 0 or x &gt;= width or row &lt; 0 or row &gt;= 13 then
		return
	end
	local column = map[x + 1]
	if overwrite or column[row + 1] == 0 or column[row + 1] == nil then
		column[row + 1] = tile
	end
end

local function putHorizontal(map, width, x, row, tile, length, overwrite)
	for offset = 0, length - 1 do
		put(map, width, x + offset, row, tile, overwrite)
	end
end

local function putVertical(map, width, x, row, tile, length, overwrite)
	for offset = 0, length - 1 do
		put(map, width, x, row + offset, tile, overwrite)
	end
end

local function copyEnvironment(environment)
	return {
		terrain = environment.terrain,
		scenery = environment.scenery,
		foreground = environment.foreground,
		backgroundControl = environment.backgroundControl,
		cloudOverride = environment.cloudOverride,
	}
end

local function decodeAreaObjects(bytes)
	local firstHeader = bytes[1] or 0
	local secondHeader = bytes[2] or 0
	local backgroundControl = bit32.band(firstHeader, 0x07)
	local foreground = if backgroundControl &gt;= 4 then 0 else backgroundControl
	if backgroundControl &lt; 4 then
		backgroundControl = 0
	end

	local cloudOverride = if bit32.rshift(secondHeader, 6) == 3 then 3 else 0
	local style = if cloudOverride ~= 0 then 0 else bit32.rshift(secondHeader, 6)
	local environment = {
		terrain = bit32.band(secondHeader, 0x0F),
		scenery = bit32.band(bit32.rshift(secondHeader, 4), 0x03),
		foreground = foreground,
		backgroundControl = backgroundControl,
		cloudOverride = cloudOverride,
	}
	local header = {
		terrain = environment.terrain,
		scenery = environment.scenery,
		foreground = environment.foreground,
		backgroundControl = environment.backgroundControl,
		cloudOverride = environment.cloudOverride,
		style = style,
		entrance = bit32.band(bit32.rshift(firstHeader, 3), 0x07),
		gameTimerSetting = bit32.rshift(firstHeader, 6),
		endColumn = 0,
		attributeEvents = {},
	}

	local commands = {}
	local page = 0
	local ordinal = 0
	local index = 3
	while index + 1 &lt;= #bytes do
		local first = bytes[index]
		local second = bytes[index + 1]
		if first == 0xFD then
			break
		end
		if bit32.band(second, 0x80) ~= 0 then
			page += 1
		end

		local column = bit32.rshift(first, 4)
		local row = bit32.band(first, 0x0F)
		local x = page * 16 + column
		ordinal += 1
		local object

		if row == 0x0D then
			if bit32.band(second, 0x40) == 0 and bit32.band(second, 0x80) == 0 then
				-- Row $0d, D6 clear, and no page increment is an absolute page select.
				page = bit32.band(second, 0x1F)
				x = page * 16 + column
			elseif bit32.band(second, 0x40) ~= 0 then
				object = {
					kind = "special13", id = bit32.band(second, 0x3F),
					x = x, row = row, byte = second, length = 0, ordinal = ordinal,
				}
			end
		elseif row == 0x0E then
			local isBackgroundChange = bit32.band(second, 0x40) == 0
			if isBackgroundChange then
				environment.terrain = bit32.band(second, 0x0F)
				environment.scenery = bit32.band(bit32.rshift(second, 4), 0x03)
			else
				local control = bit32.band(second, 0x07)
				environment.foreground = if control &lt; 4 then control else 0
				environment.backgroundControl = if control &gt;= 4 then control else 0
			end
			local event = {
				x = x,
				ordinal = ordinal,
				terrain = environment.terrain,
				scenery = environment.scenery,
				foreground = environment.foreground,
				backgroundControl = environment.backgroundControl,
				cloudOverride = environment.cloudOverride,
			}
			table.insert(header.attributeEvents, event)
			object = { kind = "attribute", x = x, row = row, byte = second, ordinal = ordinal }
		elseif row == 0x0C then
			object = {
				kind = "special12", id = bit32.band(bit32.rshift(second, 4), 0x07),
				x = x, row = row, byte = second, length = bit32.band(second, 0x0F), ordinal = ordinal,
			}
		elseif row == 0x0F then
			object = {
				kind = "special15", id = bit32.band(bit32.rshift(second, 4), 0x07),
				x = x, row = row, byte = second, length = bit32.band(second, 0x0F), ordinal = ordinal,
			}
		else
			local typeBits = bit32.band(second, 0x70)
			if typeBits ~= 0 then
				local id = bit32.rshift(typeBits, 4)
				if id == 7 and bit32.band(second, 0x08) ~= 0 then
					-- The high-pipe selector is repurposed for real/warp pipes.
					id = 0
				end
				object = {
					kind = "large", id = id, x = x, row = row, byte = second,
					length = bit32.band(second, 0x0F), ordinal = ordinal,
				}
			else
				object = {
					kind = "small", id = bit32.band(second, 0x0F), x = x,
					row = row, byte = second, length = 0, ordinal = ordinal,
				}
			end
		end

		if object then
			table.insert(commands, object)
				header.endColumn = math.max(header.endColumn, x)
		end
		index += 2
	end

	return commands, header
end

local function drawBackdrop(level, initialEnvironment, events)
	local environment = copyEnvironment(initialEnvironment)
	local eventIndex = 1
	table.sort(events, function(a, b)
		if a.x == b.x then
			return a.ordinal &lt; b.ordinal
		end
		return a.x &lt; b.x
	end)

	for x = 0, level.width - 1 do
		while eventIndex &lt;= #events and events[eventIndex].x &lt;= x do
			local event = events[eventIndex]
			environment.terrain = event.terrain
			environment.scenery = event.scenery
			environment.foreground = event.foreground
			environment.backgroundControl = event.backgroundControl
			environment.cloudOverride = event.cloudOverride
			eventIndex += 1
		end

		if environment.scenery &gt; 0 then
			local page = math.floor(x / 16)
			local index = BACK_OFFSETS[environment.scenery] + (page % 3) * 16 + (x % 16)
			local code = Data.BackSceneryData[index + 1] or 0
			if code ~= 0 then
				local row = bit32.rshift(code, 4)
				local tileGroup = (bit32.band(code, 0x0F) - 1) * 3
				for part = 0, 2 do
					local tile = Data.BackSceneryMetatiles[tileGroup + part + 1] or 0
					if tile ~= 0 then
						put(level.map, level.width, x, row + part, tile, false)
					end
				end
			end
		end

		if environment.foreground &gt; 0 and environment.foreground &lt;= 3 then
			local offset = FORE_OFFSETS[environment.foreground]
			for row = 0, 12 do
				local tile = Data.ForeSceneryData[offset + row + 1] or 0
				if tile ~= 0 then
					put(level.map, level.width, x, row, tile, true)
				end
			end
		end

		local terrainTile = AREA_TERRAIN[level.areaType + 1]
		if level.areaType == 0 and level.world == 8 then
			terrainTile = 0x62
		elseif environment.cloudOverride ~= 0 then
			terrainTile = 0x88
		end
		local topMask = Data.TerrainRenderBits[environment.terrain * 2 + 1] or 0
		local bottomMask = Data.TerrainRenderBits[environment.terrain * 2 + 2] or 0
		for row = 0, 12 do
			local mask = if row &lt; 8 then topMask else bottomMask
			if environment.cloudOverride ~= 0 and row &gt; 0 then
				mask = bit32.band(mask, 0x08)
			end
			local bitIndex = if row &lt; 8 then row else row - 8
			if bit32.band(mask, bit32.lshift(1, bitIndex)) ~= 0 then
				local tile = terrainTile
				if level.areaType == 2 and row &gt;= 11 then
					tile = 0x54
				end
				put(level.map, level.width, x, row, tile, true)
			end
		end
	end

	level.backgroundColor = environment.backgroundControl &gt;= 4
		and ({ [4] = 0x0F, [5] = 0x22, [6] = 0x0F, [7] = 0x0F })[environment.backgroundControl]
		or Data.BGColor[level.areaType + 1]
	level.initialBackgroundControl = initialEnvironment.backgroundControl
end

local function drawFlagpole(level, x)
	for row = 0, 9 do
		put(level.map, level.width, x, row, if row == 0 then 0x24 else 0x25, true)
	end
	put(level.map, level.width, x, 10, 0x61, true)
	level.flagX = x * 16
end

local function buildMap(level, commands, header)
	local maxColumn = header.endColumn
	for _, object in ipairs(commands) do
		if object.kind ~= "attribute" then
			local extra = (object.length or 0) + 2
			if object.kind == "special15" and object.id == 2 then
				extra = 6
			elseif object.kind == "special15" and object.id == 4 then
				extra = 2
			elseif object.kind == "special13" and object.id == 4 then
				extra = 13
			elseif object.kind == "large" and (object.id == 0 or object.id == 7) then
				extra = 3
			end
			maxColumn = math.max(maxColumn, object.x + extra)
		end
	end
	local width = math.clamp(math.ceil((maxColumn + 16) / 16) * 16, 32, 640)
	level.width = width
	level.map = table.create(width)
	level.blocks = table.create(width)
	level.itemTypes = table.create(width)
	for x = 1, width do
		level.map[x] = blankColumn()
		level.blocks[x] = blankMetadataColumn()
		level.itemTypes[x] = blankMetadataColumn()
	end
	level.pipes = {}
	level.coins = {}
	level.bridges = {}
	level.flagX = nil
	level.axeX = nil
	level.chainX = nil
	level.bridgeX = nil
	level.castleX = nil
	level.exitPipeX = nil
	level.endX = (width - 3) * 16

	drawBackdrop(level, {
		terrain = header.terrain,
		scenery = header.scenery,
		foreground = header.foreground,
		backgroundControl = header.backgroundControl,
		cloudOverride = header.cloudOverride,
	}, header.attributeEvents)

	local function addBlock(x, row, tile, kind, reward)
		put(level.map, width, x, row, tile, true)
		if x &gt;= 0 and x &lt; width and row &gt;= 0 and row &lt; 13 then
			level.blocks[x + 1][row + 1] = { kind = kind, reward = reward, originalTile = tile, active = true }
			level.itemTypes[x + 1][row + 1] = reward
		end
	end

	local function drawPipe(object, warp)
		local x, row = object.x, math.clamp(object.row, 0, 11)
		local shaftRows = math.clamp(bit32.band(object.length, 0x07), 1, 8)
		local topLeft, topRight = if warp then 0x10 else 0x12, if warp then 0x11 else 0x13
		put(level.map, width, x, row, topLeft, true)
		put(level.map, width, x + 1, row, topRight, true)
		for dy = 1, shaftRows do
			put(level.map, width, x, row + dy, 0x14, true)
			put(level.map, width, x + 1, row + dy, 0x15, true)
		end
		local pipe = {
			x = x * 16,
			y = row * 16,
			width = 32,
			height = (shaftRows + 1) * 16,
			warp = warp,
			targetPointer = nil,
			targetWorld = level.world - 1,
		}
		table.insert(level.pipes, pipe)
		if not warp and (level.world &gt; 1 or level.areaIndex &gt; 1) then
			local downY = row * 16
			table.insert(level.enemies, {
				type = 13,
				x = x * 16 + 8,
				y = downY,
				vx = 0,
				vy = 1,
				alive = true,
				state = "pipePlant",
				static = false,
				pipeY = downY,
				downY = downY,
				upY = downY - 24,
				moveTimer = 0,
				moving = false,
				hidden = true,
			})
		end
	end

	local function drawHorizontalStructure(x, row, length, left, middle, right)
		for offset = 0, length - 1 do
			local tile = if offset == 0 then left elseif offset == length - 1 then right else middle
			put(level.map, width, x + offset, row, tile, true)
		end
	end

	local function drawLedge(object)
		local length = object.length + 1
		if level.style == 1 then
			local half = math.floor(object.length / 2)
			for offset = 0, length - 1 do
				local tile = if offset == 0 then 0x19 elseif offset == length - 1 then 0x1B else 0x1A
				put(level.map, width, object.x + offset, object.row, tile, true)
			end
			local stem = object.x + math.clamp(half + 1, 1, math.max(1, length - 1))
			put(level.map, width, stem, object.row + 1, 0x4F, true)
			for row = object.row + 2, 12 do
				put(level.map, width, stem, row, 0x50, true)
			end
		elseif level.style == 2 then
			local x, row = object.x, object.row
			put(level.map, width, x, row, 0x64, true)
			if object.length &gt;= 1 then put(level.map, width, x, row + 1, 0x65, true) end
			if object.length &gt;= 2 then
				putVertical(level.map, width, x, row + 2, 0x66, object.length - 1, true)
			end
		else
			for offset = 0, length - 1 do
				local atStart = offset == 0 and object.x ~= 0
				local atEnd = offset == length - 1
				local tile = if atStart then 0x16 elseif atEnd then 0x18 else 0x17
				put(level.map, width, object.x + offset, object.row, tile, true)
				if not atEnd and not atStart then
					for row = object.row + 1, 12 do
						put(level.map, width, object.x + offset, row, 0x4C, false)
					end
				end
			end
		end
	end

	for _, object in ipairs(commands) do
		local x, row, id, length = object.x, object.row, object.id, object.length or 0
		if object.kind == "small" then
			if id &lt;= 3 then
				local reward = ({ "power", "coin", "hiddenCoin", "oneUp" })[id + 1]
				addBlock(x, row, QUESTION_TILES[id + 1], "question", reward)
			elseif id &gt;= 4 and id &lt;= 8 then
				local bricks = if level.areaType == 1 then GROUND_BRICKS else OTHER_BRICKS
				local reward = ({ "mushroom", "vine", "star", "multiCoin", "oneUp" })[id - 3]
				addBlock(x, row, bricks[id - 3], "brick", reward)
			elseif id == 9 then
				put(level.map, width, x, row, 0x6B, true)
				put(level.map, width, x, row + 1, 0x6C, true)
			elseif id == 10 then
				addBlock(x, row, 0xC4, "usedBlock", nil)
			elseif id == 11 then
				put(level.map, width, x, row, 0x67, true)
				put(level.map, width, x, row + 1, 0x68, true)
			end
		elseif object.kind == "large" then
			if id == 0 or id == 7 then
				drawPipe(object, id == 0)
			elseif id == 1 then
				drawLedge(object)
			elseif id == 2 then
				local tile = if level.cloudOverride then 0x88 else AREA_BRICK[level.areaType + 1]
				for offset = 0, length do
					addBlock(x + offset, row, tile, "breakableBrick", nil)
				end
			elseif id == 3 then
				putHorizontal(level.map, width, x, row, AREA_SOLID[level.areaType + 1], length + 1, true)
			elseif id == 4 then
				putHorizontal(level.map, width, x, row, AREA_COIN[level.areaType + 1], length + 1, true)
				for offset = 0, length do
					if x + offset &gt;= 0 and x + offset &lt; width then
						level.itemTypes[x + offset + 1][row + 1] = "coin"
					end
				end
			elseif id == 5 then
				for offset = 0, length do
					addBlock(x, row + offset, AREA_BRICK[level.areaType + 1], "breakableBrick", nil)
				end
			elseif id == 6 then
				putVertical(level.map, width, x, row, AREA_SOLID[level.areaType + 1], length + 1, true)
			end
		elseif object.kind == "special12" then
			if id == 0 then
				for dx = 0, length do
					for y = 8, 12 do
						put(level.map, width, x + dx, y, if level.areaType == 0 then 0x87 else 0, true)
					end
				end
			elseif id == 1 then
				local tile = if length == 0 then 0x42 else 0x41
				putHorizontal(level.map, width, x, 0, tile, length + 1, true)
			elseif id &gt;= 2 and id &lt;= 4 then
				local railRow = if id == 2 then 6 elseif id == 3 then 7 else 9
				putHorizontal(level.map, width, x, railRow, 0x0B, length + 1, true)
				putHorizontal(level.map, width, x, railRow + 1, 0x63, length + 1, true)
			elseif id == 5 then
				for dx = 0, length do
					put(level.map, width, x + dx, 10, 0x86, true)
					put(level.map, width, x + dx, 11, 0x87, true)
					put(level.map, width, x + dx, 12, 0x87, true)
				end
			elseif id == 6 or id == 7 then
				putHorizontal(level.map, width, x, if id == 6 then 3 else 7, 0xC0, length + 1, true)
			end
		elseif object.kind == "special13" then
			if id == 1 then
				drawFlagpole(level, x)
			elseif id == 2 then
				put(level.map, width, x, 6, 0xC5, true)
				level.axeX = x * 16
			elseif id == 3 then
				putVertical(level.map, width, x, 7, 0x0C, 6, true)
				level.chainX = x * 16
			elseif id == 4 then
				-- CastleBridgeObj has a fixed 13-column span at row 8.
				putHorizontal(level.map, width, x, 8, 0x89, 13, true)
				level.bridgeX = x * 16
				table.insert(level.bridges, {
					x = x,
					row = 8,
					length = 13,
				})
			end
		elseif object.kind == "special15" then
			if id == 0 then
				putVertical(level.map, width, x, 0, 0x40, 13, true)
			elseif id == 1 then
				putVertical(level.map, width, x, 1, 0x40, math.max(1, length + 1), true)
			elseif id == 2 then
				for y = 0, 10 do
					for dx = 0, 4 do
						put(level.map, width, x + dx, y, CASTLE[y + 1][dx + 1], true)
					end
				end
				level.castleX = x * 16
			elseif id == 3 then
				-- StaircaseObject starts with a one-block step at row 10, then
				-- raises each following column using StaircaseRowData in the source.
				local steps = math.clamp(length + 1, 1, 9)
				for step = 0, steps - 1 do
					local rowStart = math.max(3, 10 - step)
					for y = rowStart, 10 do
						put(level.map, width, x + step, y, 0x61, true)
					end
				end
			elseif id == 4 then
				-- ExitPipe stores its vertical row in the low nybble; the pipe
				-- itself is a fixed two-column sideways end-cap.
				local pipeRow = math.clamp(length - 1, 0, 12)
				level.exitPipeX = x * 16
				put(level.map, width, x, pipeRow, 0x1C, true)
				put(level.map, width, x + 1, pipeRow, 0x1F, true)
			end
		end
	end

	for x = 0, width - 1 do
		for row = 0, 12 do
			local tile = getCell(level.map, x, row)
			if tile == 0xC2 or tile == 0xC3 then
				table.insert(level.coins, { x = x * 16, y = row * 16, tile = tile, alive = true })
			end
		end
	end

	level.endX = math.max(level.endX, (header.endColumn + 8) * 16)
	if level.flagX then
		level.endX = math.max(level.endX, level.flagX + 160)
	end
	if level.castleX then
		level.endX = math.max(level.endX, level.castleX + 112)
	end
	level.endX = math.min(level.endX, (width - 2) * 16)
end

local function pushEnemy(level, enemyType, x, y, extra)
	local speed = if x &gt; 64 then -0.55 else 0.55
	if enemyType == 8 or enemyType == 0x15 then
		speed = -1.5
	elseif enemyType == 13 or enemyType == 45 then
		speed = 0
	end

	local enemy = {
		type = enemyType,
		x = x,
		y = y,
		vx = speed,
		vy = 0,
		alive = true,
		state = "walk",
		static = false,
	}
	if enemyType == 13 then
		enemy.state = "pipePlant"
		enemy.vy = 1
		enemy.downY = y
		enemy.upY = y - 24
		enemy.moveTimer = 0
		enemy.moving = false
		enemy.hidden = true
	elseif enemyType == 5 then
		enemy.walkTimer = 128
	elseif enemyType == 45 then
		enemy.originalX = x
		enemy.health = 5
		enemy.fireTimer = 150
		enemy.frameTimer = 32
	elseif enemyType == 0x15 then
		enemy.state = "bowserFlame"
		enemy.vx = -1.5
	end
	if extra then
		for key, value in pairs(extra) do enemy[key] = value end
	end
	table.insert(level.enemies, enemy)
end

local function decodeEnemies(level, pointer, worldIndex, hardMode, primaryHardMode)
	local name = enemyLabel(pointer)
	local bytes = if name then Data.EnemyAreas[name] else nil
	if not bytes then
		return
	end
	level.enemyAreaName = name
	local page = 0
	local index = 1
	while index + 1 &lt;= #bytes do
		local first = bytes[index]
		local second = bytes[index + 1]
		if first == 0xFF then
			break
		end
		if bit32.band(second, 0x80) ~= 0 then
			page += 1
		end
		local row = bit32.band(first, 0x0F)
		if row == 0x0F then
			page = bit32.band(second, 0x3F)
			index += 2
		elseif row == 0x0E then
			local third = bytes[index + 2] or 0
			local targetWorld = bit32.rshift(third, 5)
			local link = {
				x = page * 256 + bit32.band(first, 0xF0),
					pointer = second,
				targetWorld = targetWorld + 1,
				entrancePage = bit32.band(third, 0x1F),
			}
			if targetWorld == worldIndex then
				table.insert(level.warps, link)
			end
			index += 3
		else
			local x = page * 256 + bit32.band(first, 0xF0)
			-- Keep the row as a 16-pixel world coordinate. The framebuffer renderer
			-- adds the 32-pixel status-bar offset for enemies just as it does for Mario.
			local y = bit32.band(first, 0x0F) * 16
			local enemyType = bit32.band(second, 0x3F)
			local hardModeOnly = bit32.band(second, 0x40) ~= 0
			if not hardModeOnly or hardMode then
				if enemyType &gt;= 0x37 and enemyType &lt;= 0x3E then
					local code = enemyType - 0x37
					local count = if bit32.band(code, 0x01) ~= 0 then 3 else 2
					local yPos = if bit32.band(code, 0x02) ~= 0 then 0x70 else 0xB0
					local kind = if code &lt; 4 then (if primaryHardMode then 2 else 6) else 0
					for n = 0, count - 1 do
						pushEnemy(level, kind, x + n * 24, yPos, { group = true })
					end
				elseif VALID_ENEMIES[enemyType] and x &lt; level.width * 16 then
					pushEnemy(level, enemyType, x, y)
				end
			end
			index += 2
		end
	end
end

local function connectWarps(level)
	for _, link in ipairs(level.warps) do
		local closest, closestDistance
		for _, pipe in ipairs(level.pipes) do
			local distance = math.abs(pipe.x - link.x)
			if not closestDistance or distance &lt; closestDistance then
				closest, closestDistance = pipe, distance
			end
		end
		if closest and closestDistance &lt;= 48 then
			closest.targetPointer = link.pointer
			closest.targetWorld = link.targetWorld
			closest.entrancePage = link.entrancePage
			closest.linkX = link.x
		end
		link.targetPointer = link.pointer
	end
end

function World.getWorldAreas(world)
	return Data.WorldAreas[math.clamp(math.floor(world), 1, 8)] or {}
end

function World.getAreaPointer(world, areaIndex)
	local areas = World.getWorldAreas(world)
	return areas[math.floor(areaIndex)]
end

function World.getWorldAreaCount(world)
	return #World.getWorldAreas(world)
end

function World.getStagePointer(world, stage)
	local requested = math.clamp(math.floor(stage), 1, 4)
	local seen = 0
	for _, pointer in ipairs(World.getWorldAreas(world)) do
		if pointer ~= PIPE_INTRO_POINTER then
			seen += 1
			if seen == requested then
				return pointer
			end
		end
	end
	return World.getWorldAreas(world)[1] or 0x25
end

function World.findAreaIndex(world, pointer)
	for index, candidate in ipairs(World.getWorldAreas(world)) do
		if candidate == pointer then
			return index
		end
	end
	return nil
end

function World.isPipeIntro(pointer)
	return pointer == PIPE_INTRO_POINTER
end

function World.getAreaLabel(pointer)
	local label = areaLabel(pointer)
	return label
end

function World.getEnemyLabel(pointer)
	return enemyLabel(pointer)
end

function World.build(pointer, world, stage, options)
	options = options or {}
	local label, areaType = areaLabel(pointer)
	if not label or not Data.Areas[label] then
		warn("SMB1: source area pointer is not in the exported table", pointer, label)
		pointer = 0x25
		label, areaType = areaLabel(pointer)
	end

	local bytes = Data.Areas[label]
	local commands, header = decodeAreaObjects(bytes)
	local level = {
		pointer = pointer,
		areaName = label,
		areaType = areaType,
		areaTypeName = AREA_TYPE_NAMES[areaType + 1],
		world = world,
		stage = stage,
		areaIndex = options.areaIndex or 1,
		entrancePage = options.entrancePage or 0,
		entrance = header.entrance,
		gameTimerSetting = header.gameTimerSetting,
		style = header.style,
		cloudOverride = header.cloudOverride ~= 0,
		water = areaType == 0,
		castle = areaType == 3,
		enemies = {},
		warps = {},
	}
	buildMap(level, commands, header)
	level.areaCommands = commands
	level.initialEnvironment = {
		terrain = header.terrain,
		scenery = header.scenery,
		foreground = header.foreground,
		backgroundControl = header.backgroundControl,
		cloudOverride = header.cloudOverride,
	}

	local sourceWorldIndex = math.clamp(math.floor(world) - 1, 0, 7)
	local hardMode = options.hardMode
	if hardMode == nil then
		hardMode = world &gt;= 5 and (world &gt; 5 or stage &gt;= 3)
	end
	decodeEnemies(level, pointer, sourceWorldIndex, hardMode, options.primaryHardMode == true)
	connectWarps(level)
	level.isPipeIntro = World.isPipeIntro(pointer)
	return level
end

return World
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0103">
      <Properties>
        <string name="Name">SMBRenderer</string>
        <ProtectedString name="Source">--!strict
-- 256x240 NES-resolution renderer. The original CHR bitplanes and metatile
-- definitions are rasterized into an EditableImage, so no uploaded texture IDs
-- are needed in the Roblox place.
local AssetService = game:GetService("AssetService")
local Data = require(script.Parent:WaitForChild("SMBData"))

local Renderer = {}
Renderer.__index = Renderer

local W, H = 256, 240
local STRIDE = W * 4
local IMAGE_BYTES = W * H * 4
local AREA_NAMES = { "water", "ground", "underground", "castle" }
local MARIO_PALETTES = {
	{ 0x22, 0x16, 0x27, 0x18 },
	{ 0x22, 0x30, 0x27, 0x19 },
	{ 0x22, 0x37, 0x27, 0x16 },
}
local STAR_PALETTES = {
	{ 0x22, 0x16, 0x27, 0x18 },
	{ 0x22, 0x30, 0x27, 0x19 },
	{ 0x22, 0x37, 0x27, 0x16 },
}

-- Standard NTSC 2C02 color table, indexed by the six-bit palette values used
-- by the original PPU palette tables.
local NES_RGB = {
	{ 124, 124, 124 }, { 0, 0, 252 }, { 0, 0, 188 }, { 68, 40, 188 },
	{ 148, 0, 132 }, { 168, 0, 32 }, { 168, 16, 0 }, { 136, 20, 0 },
	{ 80, 48, 0 }, { 0, 120, 0 }, { 0, 104, 0 }, { 0, 88, 0 },
	{ 0, 64, 88 }, { 0, 0, 0 }, { 0, 0, 0 }, { 0, 0, 0 },
	{ 188, 188, 192 }, { 0, 120, 248 }, { 0, 88, 248 }, { 104, 68, 252 },
	{ 216, 0, 204 }, { 228, 0, 88 }, { 248, 56, 0 }, { 228, 92, 16 },
	{ 172, 124, 0 }, { 0, 184, 0 }, { 0, 168, 0 }, { 0, 168, 68 },
	{ 0, 136, 136 }, { 0, 0, 0 }, { 0, 0, 0 }, { 0, 0, 0 },
	{ 248, 248, 248 }, { 60, 188, 252 }, { 104, 136, 252 }, { 152, 120, 248 },
	{ 248, 120, 248 }, { 248, 88, 152 }, { 248, 120, 88 }, { 252, 160, 68 },
	{ 248, 184, 0 }, { 184, 248, 24 }, { 88, 216, 84 }, { 88, 248, 152 },
	{ 0, 232, 216 }, { 120, 120, 120 }, { 0, 0, 0 }, { 0, 0, 0 },
	{ 252, 252, 252 }, { 164, 228, 252 }, { 184, 184, 248 }, { 216, 184, 248 },
	{ 248, 184, 248 }, { 248, 164, 192 }, { 240, 208, 176 }, { 252, 224, 168 },
	{ 248, 216, 120 }, { 216, 248, 120 }, { 184, 248, 184 }, { 184, 248, 216 },
	{ 0, 252, 252 }, { 248, 216, 248 }, { 0, 0, 0 }, { 0, 0, 0 },
}

local FONT = {
	["A"] = { 14, 17, 17, 31, 17, 17, 17 }, ["B"] = { 30, 17, 17, 30, 17, 17, 30 },
	["C"] = { 14, 17, 16, 16, 16, 17, 14 }, ["D"] = { 30, 17, 17, 17, 17, 17, 30 },
	["E"] = { 31, 16, 16, 30, 16, 16, 31 }, ["F"] = { 31, 16, 16, 30, 16, 16, 16 },
	["G"] = { 14, 17, 16, 23, 17, 17, 15 }, ["H"] = { 17, 17, 17, 31, 17, 17, 17 },
	["I"] = { 14, 4, 4, 4, 4, 4, 14 }, ["J"] = { 7, 2, 2, 2, 18, 18, 12 },
	["K"] = { 17, 18, 20, 24, 20, 18, 17 }, ["L"] = { 16, 16, 16, 16, 16, 16, 31 },
	["M"] = { 17, 27, 21, 21, 17, 17, 17 }, ["N"] = { 17, 25, 21, 19, 17, 17, 17 },
	["O"] = { 14, 17, 17, 17, 17, 17, 14 }, ["P"] = { 30, 17, 17, 30, 16, 16, 16 },
	["Q"] = { 14, 17, 17, 17, 21, 18, 13 }, ["R"] = { 30, 17, 17, 30, 20, 18, 17 },
	["S"] = { 15, 16, 16, 14, 1, 1, 30 }, ["T"] = { 31, 4, 4, 4, 4, 4, 4 },
	["U"] = { 17, 17, 17, 17, 17, 17, 14 }, ["V"] = { 17, 17, 17, 17, 17, 10, 4 },
	["W"] = { 17, 17, 17, 21, 21, 21, 10 }, ["X"] = { 17, 17, 10, 4, 10, 17, 17 },
	["Y"] = { 17, 17, 10, 4, 4, 4, 4 }, ["Z"] = { 31, 1, 2, 4, 8, 16, 31 },
	["0"] = { 14, 17, 19, 21, 25, 17, 14 }, ["1"] = { 4, 12, 4, 4, 4, 4, 14 },
	["2"] = { 14, 17, 1, 2, 4, 8, 31 }, ["3"] = { 30, 1, 1, 14, 1, 1, 30 },
	["4"] = { 2, 6, 10, 18, 31, 2, 2 }, ["5"] = { 31, 16, 16, 30, 1, 1, 30 },
	["6"] = { 14, 16, 16, 30, 17, 17, 14 }, ["7"] = { 31, 1, 2, 4, 8, 8, 8 },
	["8"] = { 14, 17, 17, 14, 17, 17, 14 }, ["9"] = { 14, 17, 17, 15, 1, 1, 14 },
	["-"] = { 0, 0, 0, 31, 0, 0, 0 }, ["."] = { 0, 0, 0, 0, 0, 12, 12 },
	["!"] = { 4, 4, 4, 4, 4, 0, 4 }, ["'"] = { 12, 12, 4, 0, 0, 0, 0 },
	["/"] = { 1, 2, 2, 4, 8, 8, 16 }, ["&lt;"] = { 2, 4, 8, 16, 8, 4, 2 },
	["&gt;"] = { 8, 4, 2, 1, 2, 4, 8 }, [" "] = { 0, 0, 0, 0, 0, 0, 0 },
}

local function hexToBuffer(hex: string)
	local out = buffer.create(math.floor(#hex / 2))
	for i = 1, #hex, 2 do
		local value = tonumber(string.sub(hex, i, i + 1), 16) or 0
		buffer.writeu8(out, math.floor((i - 1) / 2), value)
	end
	return out
end

local function paletteRGB(code: number)
	return NES_RGB[bit32.band(code, 0x3F) + 1] or NES_RGB[1]
end

local function ppuPixel(chr, tile: number, x: number, y: number, bankOffset: number?): number
	local tileOffset = (bankOffset or 0) + tile * 16
	local bit = 7 - x
	local low = buffer.readu8(chr, tileOffset + y)
	local high = buffer.readu8(chr, tileOffset + y + 8)
	return bit32.band(bit32.rshift(low, bit), 1) + bit32.lshift(bit32.band(bit32.rshift(high, bit), 1), 1)
end

local function writeColor(target, offset: number, color)
	buffer.writeu8(target, offset, color[1])
	buffer.writeu8(target, offset + 1, color[2])
	buffer.writeu8(target, offset + 2, color[3])
	buffer.writeu8(target, offset + 3, 255)
end

function Renderer.new()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SMB1Screen"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 100
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	backdrop.BorderSizePixel = 0
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.Parent = screenGui

	local canvas = Instance.new("Frame")
	canvas.Name = "NESCanvas"
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.fromOffset(W, H)
	canvas.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	canvas.BorderSizePixel = 0
	canvas.ClipsDescendants = true
	canvas.Parent = screenGui

	local uiScale = Instance.new("UIScale")
	uiScale.Name = "ViewportScale"
	uiScale.Parent = canvas

	local imageLabel = Instance.new("ImageLabel")
	imageLabel.Name = "Framebuffer"
	imageLabel.BackgroundTransparency = 1
	imageLabel.BorderSizePixel = 0
	imageLabel.Size = UDim2.fromOffset(W, H)
	imageLabel.Position = UDim2.fromOffset(0, 0)
	imageLabel.ImageColor3 = Color3.new(1, 1, 1)
	imageLabel.ScaleType = Enum.ScaleType.Stretch
	imageLabel.Parent = canvas
	pcall(function()
		imageLabel.ResampleMode = Enum.ResamplerMode.Pixelated
	end)

	local self = setmetatable({}, Renderer)
	self.screenGui = screenGui
	self.canvas = canvas
	self.uiScale = uiScale
	self.imageLabel = imageLabel
	self.image = nil
	self.pixels = buffer.create(IMAGE_BYTES)
	self.errorLabel = nil
	self.touchButtons = {}
	self.metaCache = { {}, {}, {}, {} }
	self.clearCache = {}
	self.blackRow = buffer.create(STRIDE)
	self.spriteData = {
		mario = hexToBuffer(Data.CHR.mario),
		misc = hexToBuffer(Data.CHR.misc),
		enemies = hexToBuffer(Data.CHR.enemies),
	}
	self.bgData = {
		hexToBuffer(Data.CHR.bgWater),
		hexToBuffer(Data.CHR.bgGround),
		hexToBuffer(Data.CHR.bgUnderground),
		hexToBuffer(Data.CHR.bgCastle),
	}
	local rgbBlack = paletteRGB(0x0F)
	for x = 0, W - 1 do
		writeColor(self.blackRow, x * 4, rgbBlack)
	end

	local ok, editableImage = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(W, H) })
	end)
	if ok and editableImage then
		local bound = pcall(function()
			imageLabel.ImageContent = Content.fromObject(editableImage)
		end)
		if bound then
			self.image = editableImage
		else
			editableImage:Destroy()
		end
	end

	if not self.image then
		local message = Instance.new("TextLabel")
		message.Name = "SetupMessage"
		message.AnchorPoint = Vector2.new(0.5, 0.5)
		message.Position = UDim2.fromScale(0.5, 0.5)
		message.Size = UDim2.new(0.8, 0, 0, 110)
		message.BackgroundColor3 = Color3.fromRGB(14, 18, 31)
		message.BackgroundTransparency = 0.05
		message.BorderSizePixel = 0
		message.TextColor3 = Color3.fromRGB(255, 255, 255)
		message.TextWrapped = true
		message.TextSize = 20
		message.Font = Enum.Font.Code
		message.Text = "SMB1's pixel renderer needs Roblox EditableImage enabled. In Studio open Game Settings &gt; Security and turn on Allow Mesh &amp; Image APIs, then Play again."
		message.Parent = screenGui
		self.errorLabel = message
		warn("SMB1: EditableImage is unavailable; enable Allow Mesh &amp; Image APIs in Studio's Security settings.")
	end

	local camera = workspace.CurrentCamera
	local function resize()
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		local scale = math.min(viewport.X / W, viewport.Y / H)
		uiScale.Scale = math.max(scale, 0.5)
	end
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
	end
	resize()

	return self
end

function Renderer:destroy()
	if self.image then
		self.image:Destroy()
	end
	if self.screenGui then
		self.screenGui:Destroy()
	end
end

function Renderer:ensureClear(code: number)
	local key = bit32.band(code, 0x3F)
	if self.clearCache[key] then
		return self.clearCache[key]
	end
	local color = paletteRGB(key)
	local pixels = buffer.create(IMAGE_BYTES)
	for i = 0, IMAGE_BYTES - 4, 4 do
		writeColor(pixels, i, color)
	end
	self.clearCache[key] = pixels
	return pixels
end

function Renderer:clear(code: number)
	buffer.copy(self.pixels, 0, self:ensureClear(code), 0, IMAGE_BYTES)
end

function Renderer:drawPixel(x: number, y: number, colorCode: number)
	if x &lt; 0 or x &gt;= W or y &lt; 0 or y &gt;= H then
		return
	end
	writeColor(self.pixels, (math.floor(y) * W + math.floor(x)) * 4, paletteRGB(colorCode))
end

function Renderer:drawRect(x: number, y: number, width: number, height: number, colorCode: number)
	local left = math.max(0, math.floor(x))
	local top = math.max(0, math.floor(y))
	local right = math.min(W, math.floor(x + width))
	local bottom = math.min(H, math.floor(y + height))
	if right &lt;= left or bottom &lt;= top then
		return
	end
	local color = paletteRGB(colorCode)
	for py = top, bottom - 1 do
		local offset = (py * W + left) * 4
		for _ = left, right - 1 do
			writeColor(self.pixels, offset, color)
			offset += 4
		end
	end
end

function Renderer:drawText(x: number, y: number, text: string, colorCode: number, scale: number?)
	local size = scale or 1
	local cursor = math.floor(x)
	local color = paletteRGB(colorCode)
	for i = 1, #text do
		local character = string.upper(string.sub(text, i, i))
		local glyph = FONT[character] or FONT[" "]
		for gy = 1, 7 do
			local mask = glyph[gy]
			for gx = 0, 4 do
				if bit32.band(mask, bit32.lshift(1, 4 - gx)) ~= 0 then
					for sy = 0, size - 1 do
						for sx = 0, size - 1 do
							local px = cursor + gx * size + sx
							local py = y + (gy - 1) * size + sy
							if px &gt;= 0 and px &lt; W and py &gt;= 0 and py &lt; H then
								writeColor(self.pixels, (py * W + px) * 4, color)
							end
						end
					end
				end
			end
		end
		cursor += 6 * size
	end
end

function Renderer:metaPixels(areaType: number, tileId: number, bgCode: number?, areaStyle: number?)
	local background = bit32.band(bgCode or Data.BGColor[areaType + 1] or 0x0F, 0x3F)
	local style = areaStyle or 0
	local cacheKey = tileId + 1 + background * 256 + style * 16384
	local cache = self.metaCache[areaType + 1]
	local cached = cache[cacheKey]
	if cached then
		return cached
	end
	local definition = Data.Metatiles[tileId + 1] or Data.Metatiles[1]
	local paletteSet = Data.Palettes[AREA_NAMES[areaType + 1]].background
	local colors = paletteSet[definition[5] + 1]
	if style == 1 and areaType == 1 and definition[5] == 0 then
		colors = { 0x22, 0x27, 0x16, 0x0F }
	end
	local chr = self.bgData[areaType + 1]
	local out = buffer.create(16 * 16 * 4)
	for y = 0, 15 do
		for x = 0, 15 do
			local patternIndex
			if y &lt; 8 then
				patternIndex = if x &lt; 8 then definition[1] else definition[3]
			else
				patternIndex = if x &lt; 8 then definition[2] else definition[4]
			end
			local px = ppuPixel(chr, patternIndex, x % 8, y % 8)
			local paletteCode = if px == 0 then background else colors[px + 1]
			writeColor(out, (y * 16 + x) * 4, paletteRGB(paletteCode))
		end
	end
	cache[cacheKey] = out
	return out
end

function Renderer:drawMeta(areaType: number, tileId: number, x: number, y: number, cameraX: number?, bgCode: number?, areaStyle: number?)
	if tileId == 0 then
		return
	end
	local destX = math.floor(x - (cameraX or 0))
	local destY = math.floor(y)
	local left = math.max(0, destX)
	local top = math.max(0, destY)
	local right = math.min(W, destX + 16)
	local bottom = math.min(H, destY + 16)
	if right &lt;= left or bottom &lt;= top then
		return
	end
	local source = self:metaPixels(areaType, tileId, bgCode, areaStyle)
	local widthBytes = (right - left) * 4
	local sourceX = (left - destX) * 4
	for py = top, bottom - 1 do
		local sourceY = (py - destY) * 16 * 4 + sourceX
		local destination = (py * W + left) * 4
		buffer.copy(self.pixels, destination, source, sourceY, widthBytes)
	end
end

function Renderer:drawSpriteTile(chr, tileId: number, x: number, y: number, areaType: number, paletteIndex: number, flipX: boolean?, flipY: boolean?, bankOffset: number?, paletteOverride)
	local left = math.floor(x)
	local top = math.floor(y)
	local paletteSet = Data.Palettes[AREA_NAMES[areaType + 1]].sprites
	local colors = paletteOverride or paletteSet[(paletteIndex or 0) + 1]
	for py = 0, 15 do
		local sourceY = if flipY then 15 - py else py
		local tile = bit32.band(tileId, 0x3E) + math.floor(sourceY / 8)
		for px = 0, 7 do
			local sx = if flipX then 7 - px else px
			local value = ppuPixel(chr, tile, sx, sourceY % 8, bankOffset)
			if value ~= 0 then
				self:drawPixel(left + px, top + py, colors[value + 1])
			end
		end
	end
end

function Renderer:drawVine(vine, cameraX: number, areaType: number)
	if not vine.active or vine.height &lt; 8 then
		return
	end
	local topY = vine.bottomY - vine.height
	local baseX = vine.x - 8 - cameraX
	local groups = math.clamp(math.floor((vine.maxHeight or 48) / 48), 1, 2)
	for group = 0, groups - 1 do
		for segment = 0, 5 do
			local tile = if group == 0 and segment == 0 then 0x28 else 0x2A
			local x = baseX + (segment % 2) * 6
			local y = 32 + topY + group * 48 + segment * 8
			self:drawSpriteTile(
				self.spriteData.enemies,
				tile,
				x,
				y,
				areaType,
				1,
				segment % 2 == 1,
				false,
				3072
			)
		end
	end
end

function Renderer:drawMario(player, cameraX: number, areaType: number, frame: number)
	local x = math.floor(player.x - cameraX)
	local y = 32 + math.floor(player.y)
	local power = player.power or 0
	local small = power == 0
	if not small and not player.crouching then
		y -= 8
	end
	local facingLeft = player.facing &lt; 0
	local moving = math.abs(player.vx or 0) &gt; 0.15
	local which = if player.crouching then 7 elseif not player.onGround then 6 elseif moving then 2 + (math.floor(frame / 6) % 3) else 1
	local bankOffset
	local frames
	local rows
	if small then
		bankOffset = 2048
		frames = {
			{ 0x00, 0x02 }, { 0x04, 0x06 }, { 0x08, 0x0A }, { 0x0C, 0x0E },
			{ 0x10, 0x12 }, { 0x14, 0x16 },
		}
		which = math.clamp(which, 1, 6)
		rows = { frames[which] }
	elseif power &gt;= 2 then
		bankOffset = if player.crouching then 3072 else 1024
		frames = {
			{ 0x00, 0x02, 0x2C, 0x2E },
			{ 0x00, 0x02, 0x2C, 0x2E },
			{ 0x00, 0x02, 0x30, 0x32 },
			{ 0x00, 0x02, 0x14, 0x16 },
			{ 0x00, 0x02, 0x34, 0x36 },
			{ 0x00, 0x02, 0x10, 0x12 },
			{ 0x00, 0x02, 0x18, 0x1A },
		}
		rows = { { frames[which][1], frames[which][2] }, { frames[which][3], frames[which][4] } }
	else
		bankOffset = 0
		frames = {
			{ 0x00, 0x02, 0x20, 0x22 },
			{ 0x04, 0x06, 0x24, 0x26 },
			{ 0x08, 0x0A, 0x28, 0x2A },
			{ 0x0C, 0x0E, 0x2C, 0x2E },
			{ 0x10, 0x12, 0x30, 0x32 },
			{ 0x14, 0x16, 0x34, 0x36 },
			{ 0x18, 0x1A, 0x38, 0x3A },
		}
		rows = { { frames[which][1], frames[which][2] }, { frames[which][3], frames[which][4] } }
	end

	local palette = if power &gt;= 2 then MARIO_PALETTES[3]
		elseif player.currentPlayer == 2 then MARIO_PALETTES[2]
		else MARIO_PALETTES[1]
	if player.starFrames and player.starFrames &gt; 0 then
		palette = STAR_PALETTES[math.floor(frame / 4) % #STAR_PALETTES + 1]
	end
	local chr = self.spriteData.mario
	for rowIndex, parts in ipairs(rows) do
		local leftTile, rightTile = parts[1], parts[2]
		if facingLeft then
			leftTile, rightTile = rightTile, leftTile
		end
		self:drawSpriteTile(chr, leftTile, x, y + (rowIndex - 1) * 16, areaType, 0, facingLeft, false, bankOffset, palette)
		self:drawSpriteTile(chr, rightTile, x + 8, y + (rowIndex - 1) * 16, areaType, 0, facingLeft, false, bankOffset, palette)
	end
end

function Renderer:drawEnemy(enemy, cameraX: number, areaType: number, frame: number)
	if enemy.type == 13 and enemy.hidden then
		return
	end
	if not enemy.alive or enemy.state == "dead" or enemy.state == "squashed" then
		if enemy.state == "squashed" and enemy.alive then
			local chr = self.spriteData.enemies
			local x = math.floor(enemy.x - cameraX)
			local y = 32 + math.floor(enemy.y) + 8
			self:drawSpriteTile(chr, 0x26, x, y, areaType, 3, false, false, 0)
			self:drawSpriteTile(chr, 0x26, x + 8, y, areaType, 3, true, false, 0)
		end
		return
	end

	local chr = self.spriteData.enemies
	local worldX = if enemy.type == 13 then enemy.x - 8 else enemy.x
	local x = math.floor(worldX - cameraX)
	local y = 32 + math.floor(enemy.y)
	local tick = math.floor(frame / 8) % 2
	local facingLeft = enemy.vx &lt; 0
	local bankOffset = if enemy.type == 12 or enemy.type == 45 then 2048
		elseif enemy.type == 0x15 then 3072
		elseif enemy.type == 5 or enemy.type == 7 or enemy.type == 13 or enemy.type == 17 then 1024
		else 0
	local function sprite(tile, dx, dy, palette, flipX, flipY)
		self:drawSpriteTile(chr, tile, x + dx, y + dy, areaType, palette, flipX, flipY, bankOffset)
	end
	local function pair(a, b, dx, dy, palette, mirror)
		if facingLeft and mirror ~= false then
			a, b = b, a
		end
		sprite(a, dx, dy, palette, facingLeft and mirror ~= false, false)
		sprite(b, dx + 8, dy, palette, facingLeft and mirror ~= false, false)
	end

	if enemy.type == 6 then -- Goomba
		local a, b = if tick == 0 then 0x22 else 0x24, if tick == 0 then 0x24 else 0x22
		pair(a, b, 0, 0, 3, true)
	elseif enemy.type == 0 or enemy.type == 3 or enemy.type == 2 then -- Koopas and Buzzy Beetles
		if enemy.state == "shell" or enemy.state == "movingShell" then
			local tile = if enemy.type == 2 then 0x20 else 0x1A
			local palette = if enemy.type == 2 then 3 else 0
			sprite(tile, 0, 8, palette, false, false)
			sprite(tile, 8, 8, palette, true, false)
		else
			local palette = if enemy.type == 2 then 3 else 0
			local rows
			if enemy.type == 2 then
				rows = { { 0x00, 0x02 } }
			else
				rows = if tick == 0 then { { 0x38, 0x12 }, { 0x30, 0x32 } } else { { 0x18, 0x16 }, { 0x34, 0x36 } }
			end
			for rowIndex, parts in ipairs(rows) do
				pair(parts[1], parts[2], 0, -4 + (rowIndex - 1) * 16, palette, true)
			end
		end
	elseif enemy.type == 5 then -- Hammer Bro
		local parts = if tick == 0 then { 0x00, 0x02, 0x20, 0x22 } else { 0x08, 0x0A, 0x24, 0x26 }
		for i, tile in ipairs(parts) do
			local row, col = math.floor((i - 1) / 2), (i - 1) % 2
			local px = if facingLeft then 8 - col * 8 else col * 8
			sprite(tile, px, -8 + row * 16, 1, facingLeft, false)
		end
	elseif enemy.type == 13 then -- Piranha plant
		local top = if tick == 0 then 0x1C else 0x1E
		sprite(top, 0, -8, 1, false, false)
		sprite(top, 8, -8, 1, true, false)
		sprite(top + 0x20, 0, 8, 1, false, false)
		sprite(top + 0x20, 8, 8, 1, true, false)
	elseif enemy.type == 8 then -- Bullet Bill
		pair(0x1C, 0x1E, 0, 0, 3, false)
	elseif enemy.type == 7 then -- Bloober
		sprite(0x1A, 0, -4, 3, false, false)
		sprite(0x1A, 8, -4, 3, true, false)
		sprite(0x3A, 0, 12, 3, false, false)
		sprite(0x3A, 8, 12, 3, true, false)
	elseif enemy.type == 10 or enemy.type == 11 or enemy.type == 14 or enemy.type == 15 or enemy.type == 16 or enemy.type == 20 then
		local a, b = if tick == 0 then 0x2C else 0x2A, 0x2E
		local palette = if enemy.type == 11 or enemy.type == 15 then 1 else 0
		pair(a, b, 0, 0, palette, true)
		if enemy.type == 14 or enemy.type == 15 or enemy.type == 16 then
			-- Paratroopa wings are small; the body remains the authentic Koopa CHR.
			sprite(0x30, 2, -4, palette, false, true)
			sprite(0x30, 10, -4, palette, true, true)
		end
	elseif enemy.type == 12 then -- Podoboo
		sprite(0x18, 0, 0, 2, false, enemy.vy &gt;= 0)
		sprite(0x18, 8, 0, 2, true, enemy.vy &gt;= 0)
	elseif enemy.type == 17 then -- Lakitu
		local head = if tick == 0 then 0x0C else 0x30
		sprite(head, 0, -8, 1, facingLeft, false)
		sprite(head + 2, 8, -8, 1, facingLeft, false)
		sprite(0x2C, 0, 8, 1, facingLeft, false)
		sprite(0x2E, 8, 8, 1, facingLeft, false)
	elseif enemy.type == 18 then -- Spiny
		pair(if tick == 0 then 0x08 else 0x0C, if tick == 0 then 0x0A else 0x0E, 0, 0, 2, true)
	elseif enemy.type == 45 then -- Bowser
		local parts = if tick == 0 then { 0x08, 0x0A, 0x28, 0x04, 0x06, 0x20, 0x22 } else { 0x0C, 0x0E, 0x28, 0x04, 0x06, 0x24, 0x26 }
		for i, tile in ipairs(parts) do
			local col = if i &lt;= 3 then (i - 1) % 2 else (i - 4) % 2
			local row = if i &lt;= 3 then math.floor((i - 1) / 2) else 2 + math.floor((i - 4) / 2)
			local px = if facingLeft then 8 - col * 8 else col * 8
			sprite(tile, px, -8 + row * 16, 1, facingLeft, false)
		end
	else
		pair(0x22, 0x24, 0, 0, 3, false)
	end
end

function Renderer:drawPowerup(item, cameraX: number, areaType: number, frame: number)
	local x = math.floor(item.x - cameraX)
	local y = 32 + math.floor(item.y)
	local chr = self.spriteData.misc
	if item.kind == "star" then
		self:drawSpriteTile(chr, 0x34, x, y, areaType, 0, false, false)
		self:drawSpriteTile(chr, 0x36, x + 8, y, areaType, 0, false, false)
	elseif item.kind == "flower" then
		local phase = math.floor(frame / 8) % 2
		local topA, topB = if phase == 0 then 0x38 else 0x38, if phase == 0 then 0x38 else 0x3A
		self:drawSpriteTile(chr, topA, x, y, areaType, 0, false, false)
		self:drawSpriteTile(chr, topB, x + 8, y, areaType, 1, true, false)
		self:drawSpriteTile(chr, 0x3A, x, y + 16, areaType, 1, false, false)
		self:drawSpriteTile(chr, 0x3A, x + 8, y + 16, areaType, 1, true, false)
	elseif item.kind == "oneUp" then
		self:drawSpriteTile(chr, 0x3C, x, y, areaType, 1, false, false)
		self:drawSpriteTile(chr, 0x3E, x + 8, y, areaType, 1, false, false)
	else
		self:drawSpriteTile(chr, 0x3C, x, y, areaType, 2, false, false)
		self:drawSpriteTile(chr, 0x3E, x + 8, y, areaType, 2, false, false)
	end
end

function Renderer:drawFireball(fireball, cameraX: number, areaType: number, frame: number)
	local x = math.floor(fireball.x - cameraX)
	local y = 32 + math.floor(fireball.y)
	local chr = self.spriteData.mario
	local tile = if math.floor(frame / 4) % 2 == 0 then 0x3C else 0x3E
	self:drawSpriteTile(chr, tile, x, y, areaType, 2, false, false, 1024)
end

function Renderer:drawHud(state)
	for row = 0, 31 do
		buffer.copy(self.pixels, row * STRIDE, self.blackRow, 0, STRIDE)
	end
	local bright = 0x30
	self:drawText(16, 5, if state.currentPlayer == 2 then "LUIGI" else "MARIO", bright)
	self:drawText(86, 5, "TOP", bright)
	self:drawText(137, 5, "X", bright)
	self:drawText(158, 5, "WORLD", bright)
	self:drawText(218, 5, "TIME", bright)
	self:drawText(16, 20, string.format("%06d", math.min(state.score or 0, 999999)), bright)
	self:drawText(79, 20, string.format("%06d", math.min(state.topScore or 0, 999999)), bright)
	self:drawText(137, 20, string.format("%02d", (state.coins or 0) % 100), bright)
	self:drawText(160, 20, string.format("%d-%d", state.world or 1, state.stage or 1), bright)
	self:drawText(218, 20, string.format("%03d", math.max(0, state.time or 0)), bright)
end

function Renderer:drawTitle(state, frame: number)
	self:clear(0x22)
	-- A small title vignette built from the original ground CHR/metatile tables.
	for x = 0, 15 do
		self:drawMeta(1, 0x69, x * 16, 208)
		self:drawMeta(1, 0x69, x * 16, 224)
	end
	for x = 0, 5 do
		self:drawMeta(1, if x == 0 then 0x05 elseif x == 5 then 0x08 else 0x06, 5 * 16 + x * 16, 160)
	end
	for x = 0, 2 do
		self:drawMeta(1, if x == 0 then 0x80 elseif x == 2 then 0x82 else 0x81, 28 + x * 16, 54)
	end
	for y = 0, 2 do
		self:drawMeta(1, if y == 0 then 0x10 elseif y == 1 then 0x14 else 0x14, 218, 160 + y * 16)
	end
	self:drawRect(0, 0, W, 32, 0x0F)
	self:drawText(40, 39, "SUPER", 0x30, 2)
	self:drawText(22, 58, "MARIO BROS.", 0x28, 2)
	self:drawText(62, 105, "WORLD 1-1", 0x30)
	local selector = if state.menuIndex == 1 then "&gt;" else " "
	self:drawText(40, 137, selector .. "1 PLAYER GAME", 0x30)
	selector = if state.menuIndex == 2 then "&gt;" else " "
	self:drawText(40, 152, selector .. "2 PLAYER GAME", 0x30)
	self:drawText(52, 191, "1985 NINTENDO", 0x30)
	-- Logo-side Mario, using the authentic sprite CHR.
	local tile = if math.floor(frame / 10) % 2 == 0 then 0x00 else 0x04
	self:drawSpriteTile(self.spriteData.mario, tile, 190, 116, 1, 0, false, false, 2048)
	self:drawSpriteTile(self.spriteData.mario, tile + 2, 198, 116, 1, 0, false, false, 2048)
end

function Renderer:drawStageCard(state)
	self:drawRect(0, 0, W, H, 0x0F)
	self:drawText(84, 91, "WORLD", 0x30)
	self:drawText(95, 108, string.format("%d-%d", state.world or 1, state.stage or 1), 0x30)
	self:drawText(85, 130, string.format("X %02d", state.lives or 3), 0x30)
end

function Renderer:drawOverlay(text: string, y: number)
	self:drawRect(32, y - 7, 192, 22, 0x0F)
	local x = math.floor((W - #text * 6) / 2)
	self:drawText(x, y, text, 0x30)
end

function Renderer:draw(state)
	if not self.image then
		return
	end
	local frame = state.frame or 0
	if state.mode == "title" then
		self:drawTitle(state, frame)
	elseif state.mode == "intro" then
		self:drawStageCard(state)
	elseif state.mode == "gameOver" then
		self:clear(0x0F)
		self:drawText(94, 99, "GAME OVER", 0x30)
		self:drawText(52, 130, "PRESS START", 0x30)
	elseif state.mode == "victory" then
		self:clear(0x0F)
		self:drawText(76, 68, "THANK YOU", 0x30)
		self:drawText(66, 84, "MARIO!", 0x30)
		self:drawText(34, 120, "YOUR QUEST IS OVER", 0x30)
		self:drawText(52, 149, "THE END", 0x30)
	elseif state.level then
		local level = state.level
		local areaType = level.areaType
		local bg = level.backgroundColor or Data.BGColor[areaType + 1] or 0x0F
		self:clear(bg)
		local cameraX = math.floor(state.cameraX or 0)
		for _, vine in ipairs(state.vines or {}) do
			if vine.active and vine.x + 16 &gt;= cameraX and vine.x &lt;= cameraX + W then
				self:drawVine(vine, cameraX, areaType)
			end
		end
		local startCol = math.max(0, math.floor(cameraX / 16))
		local endCol = math.min(level.width - 1, startCol + 17)
		for worldCol = startCol, endCol do
			local col = level.map[worldCol + 1]
			if col then
				local screenX = worldCol * 16 - cameraX
				for row = 0, 12 do
					local tile = col[row + 1] or 0
					if tile ~= 0 then
						self:drawMeta(areaType, tile, screenX, 32 + row * 16, nil, bg, level.style)
					end
				end
			end
		end
		for _, coin in ipairs(level.coins or {}) do
			if coin.alive ~= false and coin.x + 16 &gt;= cameraX and coin.x &lt;= cameraX + W then
				local tile = coin.tile or 0xC2
				local col = math.floor(coin.x / 16) + 1
				local row = math.floor(coin.y / 16) + 1
				if level.map[col] and level.map[col][row] == tile then
					self:drawMeta(areaType, tile, coin.x, 32 + coin.y, cameraX, bg, level.style)
				end
			end
		end
		for _, enemy in ipairs(state.enemies or {}) do
			if enemy.x + 32 &gt;= cameraX and enemy.x &lt;= cameraX + W then
				self:drawEnemy(enemy, cameraX, areaType, frame)
			end
		end
		for _, item in ipairs(state.items or {}) do
			if item.alive ~= false and item.x + 24 &gt;= cameraX and item.x &lt;= cameraX + W then
				self:drawPowerup(item, cameraX, areaType, frame)
			end
		end
		for _, fireball in ipairs(state.fireballs or {}) do
			if fireball.alive and fireball.x + 16 &gt;= cameraX and fireball.x &lt;= cameraX + W then
				self:drawFireball(fireball, cameraX, areaType, frame)
			end
		end
		for _, effect in ipairs(state.effects or {}) do
			if effect.timer &gt; 0 then
				self:drawText(math.floor(effect.x - cameraX), math.floor(32 + effect.y), effect.text, 0x30)
			end
		end
		if state.player and state.mode ~= "dying" then
			self:drawMario(state.player, cameraX, areaType, frame)
		end
		self:drawHud(state)
		if state.mode == "paused" then
			self:drawOverlay("PAUSE", 112)
		elseif state.mode == "flagpole" then
			self:drawOverlay("", 112)
		elseif state.mode == "stageClear" then
			self:drawOverlay("COURSE CLEAR", 105)
		elseif state.mode == "dying" then
			self:drawOverlay("", 112)
		end
		if state.introFrames and state.introFrames &gt; 0 then
			self:drawRect(0, 32, W, H - 32, bg)
			self:drawText(84, 93, "WORLD", 0x30)
			self:drawText(96, 110, string.format("%d-%d", state.world, state.stage), 0x30)
		end
	end
	self.image:WritePixelsBuffer(Vector2.new(0, 0), Vector2.new(W, H), self.pixels)
end

function Renderer:addTouchControls(onChange)
	if not game:GetService("UserInputService").TouchEnabled then
		return nil
	end
	local folder = Instance.new("Folder")
	folder.Name = "TouchControls"
	folder.Parent = self.canvas
	local map = {
		{ "Left", 12, 190, "&lt;" }, { "Right", 46, 190, "&gt;" },
		{ "Run", 171, 190, "B" }, { "Jump", 211, 190, "A" },
	}
	for _, spec in ipairs(map) do
		local name, x, y, text = spec[1], spec[2], spec[3], spec[4]
		local button = Instance.new("TextButton")
		button.Name = name
		button.Size = UDim2.fromOffset(32, 32)
		button.Position = UDim2.fromOffset(x, y)
		button.BackgroundColor3 = Color3.fromRGB(24, 26, 36)
		button.BackgroundTransparency = 0.25
		button.BorderSizePixel = 0
		button.Text = text
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		button.TextSize = 18
		button.Font = Enum.Font.Code
		button.AutoButtonColor = true
		button.Parent = folder
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				onChange(name, true)
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				onChange(name, false)
			end
		end)
		button.MouseLeave:Connect(function()
			onChange(name, false)
		end)
	end
	self.touchButtons = folder
	return folder
end

return Renderer
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0104">
      <Properties>
        <string name="Name">SMBGame</string>
        <ProtectedString name="Source">--!nonstrict
-- A local, frame-stepped SMB1 runtime. The level/object tables remain source-driven;
-- this module supplies the first playable single-player rules layer.
local World = require(script.Parent:WaitForChild("SMBWorld"))
local Data = require(script.Parent:WaitForChild("SMBData"))

local Game = {}
Game.__index = Game

local STEP = 1 / 60
local PLAYER_WIDTH = 12
local START_TIME = 400
local TIMER_INTERVAL_FRAMES = 24
local TIMER_BY_SETTING = { 400, 300, 200 }
local ENTRANCE_Y = { [0] = 0, [1] = 32, [2] = 176, [3] = 80, [4] = 0, [5] = 0, [6] = 176, [7] = 176 }
local HALFWAY_PAGES = {
	{ 5, 6, 4, 0 }, { 6, 5, 7, 0 }, { 6, 6, 4, 0 }, { 6, 6, 4, 0 },
	{ 6, 6, 4, 0 }, { 6, 6, 6, 0 }, { 6, 5, 7, 0 }, { 0, 0, 0, 0 },
}
local MAX_SCORE = 999999

local function clampScore(score)
	return math.clamp(score, 0, MAX_SCORE)
end

local function tileIsSolid(level, column, row)
	if column &lt; 0 or column &gt;= level.width then
		return true
	end
	if row &lt; 0 or row &gt;= 13 then
		return false
	end
	local columnData = level.map[column + 1]
	local tileId = columnData and columnData[row + 1] or 0
	if tileId == 0 then
		return false
	end
	local definition = Data.Metatiles[tileId + 1]
	return definition ~= nil and bit32.band(definition[6] or 0, 0x01) ~= 0
end

local function solidAt(level, x, y)
	if y &lt; 0 then
		return false
	end
	return tileIsSolid(level, math.floor(x / 16), math.floor(y / 16))
end

local function playerHeight(player)
	if player.crouching then
		return 16
	end
	return if (player.power or 0) &gt; 0 then 32 else 16
end

local function overlaps(ax, ay, aw, ah, bx, by, bw, bh)
	return ax &lt; bx + bw and ax + aw &gt; bx and ay &lt; by + bh and ay + ah &gt; by
end

local function surfaceAt(level, worldX)
	local column = math.clamp(math.floor(worldX / 16), 0, level.width - 1)
	local row = 12
	while row &gt;= 0 and not tileIsSolid(level, column, row) do
		row -= 1
	end
	if row &lt; 0 then
		return 160
	end
	while row &gt; 0 and tileIsSolid(level, column, row - 1) do
		row -= 1
	end
	return row * 16
end

function Game.new()
	local self = setmetatable({}, Game)
	self.state = {
		mode = "title",
		frame = 0,
		menuIndex = 1,
		world = 1,
		stage = 1,
		lives = 3,
		score = 0,
		topScore = 0,
		coins = 0,
		time = START_TIME,
		cameraX = 0,
		currentPlayer = 1,
		numberOfPlayers = 1,
		players = nil,
		checkpointPage = 0,
		items = {},
		fireballs = {},
		vines = {},
		effects = {},
	}
	self.buttons = {}
	self.pressed = {}
	self.accumulator = 0
	self.flagpoleFrames = 0
	self.transitionFrames = 0
	self.timerFrames = 0
	self.fireCooldown = 0
	self.bridgeCollapseTimer = 0
	self.bridgeCollapseStep = 0
	return self
end

function Game:setButton(name, isDown)
	local wasDown = self.buttons[name] == true
	self.buttons[name] = isDown == true
	if isDown and not wasDown then
		self.pressed[name] = true
	end
end

function Game:getState()
	return self.state
end

function Game:_syncActiveProfile()
	local profiles = self.state.players
	local profile = profiles and profiles[self.state.currentPlayer]
	if not profile then
		return
	end
	profile.lives = self.state.lives
	profile.score = self.state.score
	profile.coins = self.state.coins
	if self.state.player then
		profile.power = self.state.player.power or 0
	end
end

function Game:_award(points)
	self.state.score = clampScore(self.state.score + points)
	self.state.topScore = math.max(self.state.topScore, self.state.score)
	self:_syncActiveProfile()
end

function Game:_addCoin()
	self.state.coins += 1
	self:_award(200)
	if self.state.coins &gt;= 100 then
		self.state.coins = 0
		self.state.lives += 1
		self:_syncActiveProfile()
	end
end

function Game:_addEffect(x, y, text, points)
	table.insert(self.state.effects, {
		x = x,
		y = y,
		text = text or tostring(points or ""),
		timer = 42,
		vy = -0.5,
	})
end

function Game:_loadStage(world, stage, pointer, entrancePage, preservePower, powerOverride, preserveTimer)
	self:_syncActiveProfile()
	local previousTime = self.state.time or START_TIME
	local retainedPower = 0
	if preservePower then
		if powerOverride ~= nil then
			retainedPower = powerOverride
		elseif self.state.player then
			retainedPower = self.state.player.power or 0
		else
			local profile = self.state.players and self.state.players[self.state.currentPlayer]
			retainedPower = profile and profile.power or 0
		end
	end

	world = math.clamp(math.floor(world), 1, 8)
	stage = math.clamp(math.floor(stage), 1, 4)
	pointer = pointer or World.getStagePointer(world, stage)
	local areaIndex = World.findAreaIndex(world, pointer) or stage
	local level = World.build(pointer, world, stage, {
		areaIndex = areaIndex,
		entrancePage = entrancePage or 0,
		hardMode = world &gt;= 5 and (world &gt; 5 or stage &gt;= 3),
		primaryHardMode = self.state.primaryHardMode == true,
	})
	self.state.world = world
	self.state.stage = stage
	self.state.level = level
	self.state.enemies = level.enemies
	self.state.items = {}
	self.state.fireballs = {}
	self.state.vines = {}
	self.state.effects = {}
	local timerSetting = level.gameTimerSetting or 0
	self.state.time = if preserveTimer then previousTime
		elseif timerSetting &gt; 0 then (TIMER_BY_SETTING[timerSetting] or START_TIME)
		else previousTime
	self.state.hurryUp = self.state.time &lt;= 100
	self.timerFrames = 0
	self.fireCooldown = 0
	local maxCamera = math.max(0, level.width * 16 - 256)
	self.state.cameraX = math.clamp((entrancePage or 0) * 256, 0, maxCamera)
	self.state.checkpointPage = entrancePage or 0
	self.state.halfwayPage = HALFWAY_PAGES[world][stage]
	self.bridgeCollapseTimer = 0
	self.bridgeCollapseStep = 0

	local startX = math.clamp((entrancePage or 0) * 256 + 40, 16, math.max(16, level.width * 16 - 32))
	local floorY = surfaceAt(level, startX + PLAYER_WIDTH / 2)
	local spawnHeight = if retainedPower &gt; 0 then 32 else 16
	local spawnY = ENTRANCE_Y[level.entrance] or 0
	if level.entrance == 2 or level.entrance &gt;= 6 then
		spawnY = floorY - spawnHeight
	end
	local onGround = math.abs((spawnY + spawnHeight) - floorY) &lt;= 2
	self.state.player = {
		x = startX,
		y = spawnY,
		vx = 0,
		vy = 0,
		facing = 1,
		power = retainedPower,
		currentPlayer = self.state.currentPlayer,
		onGround = onGround,
		crouching = false,
		climbing = false,
		vineIndex = nil,
		swimCooldown = 0,
		starFrames = 0,
		invulnFrames = 0,
	}
	self:_syncActiveProfile()
	self.state.introFrames = 100
	self.state.mode = "intro"
end

function Game:_startNewGame()
	self.state.numberOfPlayers = if self.state.menuIndex == 2 then 2 else 1
	self.state.currentPlayer = 1
	self.state.players = {
		{ lives = 3, score = 0, coins = 0, power = 0 },
		{ lives = 3, score = 0, coins = 0, power = 0 },
	}
	self.state.score = 0
	self.state.coins = 0
	self.state.lives = 3
	self.state.time = START_TIME
	self.state.hurryUp = false
	self.state.primaryHardMode = false
	self.state.topScore = math.max(self.state.topScore or 0, 0)
	self.state.player = nil
	self.state.level = nil
	self.state.enemies = {}
	self.state.checkpointPage = 0
	self:_loadStage(1, 1)
end

function Game:_continueWithPlayer(playerNumber)
	local profile = self.state.players and self.state.players[playerNumber]
	if not profile or profile.lives &lt;= 0 then
		return false
	end
	local world = self.state.world
	local stage = self.state.stage
	local pointer = self.state.level and self.state.level.pointer or World.getStagePointer(world, stage)
	local checkpoint = self.state.checkpointPage or 0
	self.state.currentPlayer = playerNumber
	self.state.lives = profile.lives
	self.state.score = profile.score
	self.state.coins = profile.coins
	self:_loadStage(world, stage, pointer, checkpoint, true, profile.power)
	return true
end

function Game:_loseLife()
	self:_syncActiveProfile()
	self.state.lives -= 1
	local profile = self.state.players and self.state.players[self.state.currentPlayer]
	if profile then
		profile.lives = self.state.lives
		profile.power = 0
	end

	if self.state.lives &lt;= 0 then
		local otherPlayer = if self.state.currentPlayer == 1 then 2 else 1
		local otherProfile = self.state.players and self.state.players[otherPlayer]
		if self.state.numberOfPlayers == 2 and otherProfile and otherProfile.lives &gt; 0 then
			self:_continueWithPlayer(otherPlayer)
			return
		end
		self.state.mode = "gameOver"
		self.state.level = nil
		self.state.player = nil
		self.state.enemies = {}
		self.state.items = {}
		self.state.fireballs = {}
		self.state.vines = {}
		return
	end
	local pointer = self.state.level and self.state.level.pointer or World.getStagePointer(self.state.world, self.state.stage)
	self:_loadStage(self.state.world, self.state.stage, pointer, self.state.checkpointPage or 0, false)
end

function Game:_startStageClear()
	if self.state.mode == "stageClear" or self.state.mode == "victory" then
		return
	end
	local timeBonus = math.max(0, self.state.time or 0) * 50
	if timeBonus &gt; 0 then
		self:_award(timeBonus)
		self.state.time = 0
	end
	self:_syncActiveProfile()
	self.state.mode = "stageClear"
	self.transitionFrames = 110
end

function Game:_startFlagpole()
	if self.state.mode ~= "playing" then
		return
	end
	self.state.mode = "flagpole"
	self.flagpoleFrames = 60
	local player = self.state.player
	local bonus
	local collisionY = player.y + 32
	if collisionY &gt;= 0x90 then
		bonus = 100
	elseif collisionY &gt;= 0x68 then
		bonus = 400
	elseif collisionY &gt;= 0x50 then
		bonus = 800
	elseif collisionY &gt;= 0x22 then
		bonus = 2000
	else
		bonus = 5000
	end
	self:_award(bonus)
	self:_addEffect(player.x, player.y, tostring(bonus), bonus)
end

function Game:_activateAxe()
	local level = self.state.level
	local player = self.state.player
	if level.axeUsed then
		return
	end
	level.axeUsed = true
	local axeColumn = math.floor(level.axeX / 16) + 1
	if level.map[axeColumn] then
		level.map[axeColumn][7] = 0
	end
	if player then
		player.vx = 0
		player.vy = 0
		player.autoControl = "collapse"
	end
	self.bridgeCollapseTimer = 0
	self.bridgeCollapseStep = 0
end

function Game:_collapseBridgeTick()
	local level = self.state.level
	if not level or not level.axeUsed then
		return
	end
	self.bridgeCollapseTimer += 1
	if self.bridgeCollapseTimer &lt; 4 then
		return
	end
	self.bridgeCollapseTimer = 0

	local step = self.bridgeCollapseStep
	if step == 1 and level.chainX then
		local column = math.floor(level.chainX / 16) + 1
		if level.map[column] then
			for row = 8, 13 do
				level.map[column][row] = 0
			end
		end
	elseif step &gt;= 2 and step &lt;= 14 then
		local offset = 14 - step
		for _, bridge in ipairs(level.bridges or {}) do
			local column = bridge.x + offset + 1
			if level.map[column] then
				level.map[column][bridge.row + 1] = 0
			end
		end
	elseif step == 15 then
		for _, enemy in ipairs(level.enemies) do
			if enemy.alive and enemy.type == 45 then
				enemy.state = "falling"
				enemy.vy = 0
			end
		end
	end
	self.bridgeCollapseStep += 1
end

function Game:_updateAxeVictory(player, level)
	if player.autoControl == "collapse" then
		-- The NES enters a dedicated victory mode after the axe is touched:
		-- Mario stays put while the bridge collapses, rather than falling with it.
		player.vx = 0
		player.vy = 0
		player.onGround = true
		self:_collapseBridgeTick()

		local bowserPending = false
		for _, enemy in ipairs(self.state.enemies or {}) do
			if enemy.type == 45 and enemy.alive then
				if enemy.state == "falling" then
					enemy.vy = math.min((enemy.vy or 0) + 0.24, 5)
					enemy.y += enemy.vy
					if enemy.y &gt; 224 then
						enemy.alive = false
					else
						bowserPending = true
					end
				else
					enemy.vx = 0
					enemy.vy = 0
					bowserPending = true
				end
			end
		end

		if self.bridgeCollapseStep &gt;= 16 and not bowserPending then
			for _, enemy in ipairs(self.state.enemies or {}) do
				enemy.alive = false
			end
			player.autoControl = "walk"
		end
	elseif player.autoControl == "walk" then
		player.facing = 1
		player.vx = 1
		player.vy = 0
		player.x = math.min(player.x + 1, level.width * 16 - PLAYER_WIDTH)
		local maxCamera = math.max(0, level.width * 16 - 256)
		self.state.cameraX = math.clamp(player.x - 112, 0, maxCamera)
		local targetX = if level.exitPipeX then level.exitPipeX + 24 else level.endX
		if player.x &gt;= targetX then
			self:_startStageClear()
		end
	end

	self:_syncActiveProfile()
	return true
end

function Game:_advanceStage()
	local level = self.state.level
	local world = self.state.world
	local stage = self.state.stage + 1
	if stage &gt; 4 then
		stage = 1
		world += 1
	end
	if level and level.axeUsed and world &gt; self.state.world then
		if self.state.world == 8 then
			self.state.mode = "victory"
			self.state.level = nil
			return
		end
		world = self.state.world + 1
		stage = 1
	end
	if world &gt; 8 then
		self.state.mode = "victory"
		self.state.level = nil
		return
	end
	self:_loadStage(world, stage, nil, nil, true)
end

function Game:_spawnBlockReward(reward, column, row)
	if reward == "coin" or reward == "hiddenCoin" or reward == "multiCoin" then
		self:_addCoin()
		self:_addEffect(column * 16, row * 16, "200")
	elseif reward == "oneUp" then
		table.insert(self.state.items, {
			kind = "oneUp",
			x = column * 16,
			y = row * 16 - 16,
			vx = 1.1,
			vy = -1,
			alive = true,
			emergeFrames = 16,
		})
	elseif reward ~= nil then
		local kind = reward
		if kind == "power" then
			kind = if (self.state.player.power or 0) == 0 then "mushroom" else "flower"
		elseif kind == "vine" then
			local columnData = self.state.vines
			local height = 48 * math.clamp(#columnData + 1, 1, 2)
			table.insert(columnData, {
				x = column * 16 + 8,
				bottomY = row * 16,
				height = 0,
				maxHeight = height,
				growthFrames = 0,
				active = true,
			})
			return
		end
		if kind == "mushroom" or kind == "star" or kind == "flower" then
			table.insert(self.state.items, {
				kind = kind,
				x = column * 16,
				y = row * 16 - 16,
				vx = if kind == "star" then 1.8 else 1.1,
				vy = -1,
				alive = true,
				emergeFrames = 16,
			})
		end
	end
end

function Game:_hitBlock(column, row)
	local level = self.state.level
	local blockColumn = level.blocks[column + 1]
	local block = blockColumn and blockColumn[row + 1]
	if not block or not block.active then
		return
	end
	local player = self.state.player
	if block.kind == "breakableBrick" then
		if (player.power or 0) &gt; 0 then
			level.map[column + 1][row + 1] = 0
			block.active = false
			self:_award(50)
			self:_addEffect(column * 16, row * 16, "50")
		end
		return
	end

	if block.kind == "brick" and block.reward == "multiCoin" then
		if block.multiCoinUntil == nil then
			block.multiCoinUntil = self.state.frame + 11
		elseif self.state.frame &gt; block.multiCoinUntil then
			block.active = false
			level.map[column + 1][row + 1] = 0xC4
			return
		end
		self:_spawnBlockReward(block.reward, column, row)
		return
	end

	block.active = false
	if block.kind ~= "usedBlock" then
		level.map[column + 1][row + 1] = 0xC4
		self:_spawnBlockReward(block.reward, column, row)
	end
end

function Game:_resolvePlayerMotion(player, dx, dy)
	local level = self.state.level
	local oldX = player.x
	local oldY = player.y
	local height = playerHeight(player)
	local newX = oldX + dx
	if dx &gt; 0 then
		local edge = newX + PLAYER_WIDTH - 1
		for y = player.y + 2, player.y + height - 2, 7 do
			if solidAt(level, edge, y) then
				newX = math.floor(edge / 16) * 16 - PLAYER_WIDTH
				player.vx = 0
				break
			end
		end
	elseif dx &lt; 0 then
		local edge = newX
		for y = player.y + 2, player.y + height - 2, 7 do
			if solidAt(level, edge, y) then
				newX = (math.floor(edge / 16) + 1) * 16
				player.vx = 0
				break
			end
		end
	end
	player.x = math.clamp(newX, 0, level.width * 16 - PLAYER_WIDTH)

	local newY = oldY + dy
	player.onGround = false
	if dy &lt; 0 then
		if newY &lt; 0 then
			newY = 0
			player.vy = 0
		end
		local row = math.floor(newY / 16)
		local leftColumn = math.floor((player.x + 2) / 16)
		local rightColumn = math.floor((player.x + PLAYER_WIDTH - 2) / 16)
		for column = leftColumn, rightColumn do
			if tileIsSolid(level, column, row) then
				newY = (row + 1) * 16
				player.vy = 0
				self:_hitBlock(column, row)
			end
		end
	elseif dy &gt;= 0 then
		local bottom = newY + height
		local row = math.floor((bottom - 0.001) / 16)
		local leftColumn = math.floor((player.x + 2) / 16)
		local rightColumn = math.floor((player.x + PLAYER_WIDTH - 2) / 16)
		for column = leftColumn, rightColumn do
			if tileIsSolid(level, column, row) then
				newY = row * 16 - height
				player.vy = 0
				player.onGround = true
			end
		end
	end
	player.y = newY
	return oldX, oldY
end

function Game:_spawnFireball()
	local player = self.state.player
	if not player or player.power &lt; 2 or self.fireCooldown &gt; 0 then
		return
	end
	local height = playerHeight(player)
	table.insert(self.state.fireballs, {
		x = player.x + (player.facing &gt; 0 and PLAYER_WIDTH or -8),
		y = player.y + math.floor(height / 2),
		vx = player.facing * 3.6,
		vy = -1.5,
		bounces = 0,
		alive = true,
	})
	self.fireCooldown = 18
end

function Game:_damagePlayer()
	local player = self.state.player
	if player.starFrames &gt; 0 or player.invulnFrames &gt; 0 then
		return
	end
	if player.power &gt; 0 then
		local height = playerHeight(player)
		player.power = 0
		player.crouching = false
		player.y += height - 16
		player.invulnFrames = 100
		self:_syncActiveProfile()
		return
	end
	self.state.mode = "dying"
	self.transitionFrames = 75
	player.vx = 0
	player.vy = -3
end

function Game:_updatePipePlant(enemy)
	if enemy.moveTimer &gt; 0 then
		enemy.moveTimer -= 1
		return
	end
	if not enemy.moving then
		local player = self.state.player
		if enemy.vy &gt; 0 and player
			and math.abs((player.x + PLAYER_WIDTH / 2) - enemy.x) &lt; 0x21 then
			return
		end
		enemy.vy = -enemy.vy
		enemy.moving = true
		enemy.hidden = false
	end
	if self.state.frame % 2 == 0 then
		return
	end

	enemy.y += enemy.vy
	local targetY = if enemy.vy &lt; 0 then enemy.upY else enemy.downY
	if (enemy.vy &lt; 0 and enemy.y &lt;= targetY) or (enemy.vy &gt; 0 and enemy.y &gt;= targetY) then
		enemy.y = targetY
		enemy.moving = false
		enemy.moveTimer = 64
		enemy.hidden = enemy.vy &gt; 0
	end
end

function Game:_updateEnemies()
	local level = self.state.level
	for _, enemy in ipairs(self.state.enemies or {}) do
		if enemy.alive then
			if enemy.state == "pipePlant" then
				self:_updatePipePlant(enemy)
			elseif enemy.state == "squashed" then
				enemy.timer = (enemy.timer or 24) - 1
				if enemy.timer &lt;= 0 then
					enemy.alive = false
				end
			elseif enemy.state == "shell" then
				enemy.timer = (enemy.timer or 600) - 1
				if enemy.timer &lt;= 0 then
					enemy.state = "walk"
				enemy.vx = if enemy.x &gt; self.state.player.x then -0.55 else 0.55
					enemy.vy = 0
				end
			elseif not enemy.static then
				if enemy.state ~= "movingShell" and enemy.state ~= "shell" then
					enemy.vy = math.min((enemy.vy or 0) + 0.24, 5)
				end
				local oldX = enemy.x
				local nextX = enemy.x + (enemy.vx or 0)
				local enemyHeight = if enemy.type == 45 then 32 else 16
				local checkY = enemy.y + enemyHeight - 2
				if solidAt(level, nextX + (enemy.vx &gt; 0 and 14 or 1), checkY) then
					enemy.vx = -(enemy.vx or 0)
					nextX = oldX
				end
				enemy.x = math.clamp(nextX, 0, level.width * 16 - 16)
				if enemy.vy and enemy.vy ~= 0 then
					local nextY = enemy.y + enemy.vy
					if enemy.vy &gt; 0 and (solidAt(level, enemy.x + 3, nextY + enemyHeight - 1) or solidAt(level, enemy.x + 13, nextY + enemyHeight - 1)) then
						local row = math.floor((nextY + enemyHeight - 1) / 16)
						enemy.y = row * 16 - enemyHeight
						enemy.vy = 0
					elseif enemy.vy &lt; 0 and solidAt(level, enemy.x + 8, nextY) then
						enemy.vy = 0
					else
						enemy.y = nextY
					end
				end
				if enemy.y &gt; 224 then
					enemy.alive = false
				end
			end
		end
	end
end

function Game:_killEnemy(enemy, points, stomp, forceKill)
	if enemy.type == 45 then
		if not forceKill then
			return
		end
		enemy.health = math.max(0, (enemy.health or 5) - 1)
		if enemy.health == 0 then
			enemy.state = "defeated"
			enemy.vx = 0
			enemy.vy = -2
			self:_award(5000)
			self:_addEffect(enemy.x, enemy.y, "5000")
		end
		return
	end

	if stomp and (enemy.state == "shell" or enemy.state == "movingShell") then
		enemy.state = "shell"
		enemy.vx = 0
		enemy.vy = 0
		enemy.timer = 600
		self:_award(points or 1000)
		self:_addEffect(enemy.x, enemy.y, tostring(points or 1000))
		return
	end
	if not forceKill and (enemy.type == 0 or enemy.type == 2 or enemy.type == 3) then
		if enemy.state ~= "movingShell" then
			enemy.state = "shell"
			enemy.vx = 0
			enemy.vy = 0
			enemy.timer = 600
			self:_award(points or 100)
			self:_addEffect(enemy.x, enemy.y, tostring(points or 100))
			return
		end
	end
	if stomp then
		enemy.state = "squashed"
		enemy.timer = 24
		enemy.vy = 0
	else
		enemy.alive = false
	end
	self:_award(points or 100)
	self:_addEffect(enemy.x, enemy.y, tostring(points or 100))
end

function Game:_checkPlayerEnemyCollisions(previousBottom)
	local player = self.state.player
	local pHeight = playerHeight(player)
	for _, enemy in ipairs(self.state.enemies or {}) do
		local isPlant = enemy.type == 13 or enemy.state == "pipePlant"
		if enemy.alive and enemy.state ~= "dead" and enemy.state ~= "squashed"
			and not (enemy.type == 45 and (enemy.state == "falling" or enemy.state == "defeated"))
			and not enemy.static and not (isPlant and enemy.hidden) then
			local enemyX = if isPlant then enemy.x - 8 else enemy.x
			local enemyY = if isPlant then enemy.y - 8 else enemy.y
			local enemyWidth = if isPlant then 16 else 14
			local enemyHeight = if isPlant or enemy.type == 45 then 32 else 16
			if overlaps(player.x + 1, player.y + 1, PLAYER_WIDTH - 2, pHeight - 2,
				enemyX + 1, enemyY + 1, enemyWidth, enemyHeight - 2) then
				if isPlant or enemy.type == 45 then
					if player.starFrames == 0 then
						self:_damagePlayer()
					end
				elseif player.starFrames &gt; 0 then
					self:_killEnemy(enemy, 200, false, true)
				elseif player.vy &gt; 0 and previousBottom &lt;= enemyY + 8 then
					self:_killEnemy(enemy, 100, true)
					player.vy = -3.4
					player.onGround = false
				elseif enemy.state == "shell" then
					enemy.state = "movingShell"
					enemy.vx = if player.x &lt; enemy.x then 4 else -4
					self:_award(100)
				else
					self:_damagePlayer()
				end
				if self.state.mode == "dying" then
					return
				end
			end
		end
	end
end

function Game:_updateItems()
	local level = self.state.level
	local player = self.state.player
	for _, item in ipairs(self.state.items) do
		if item.alive then
			if (item.emergeFrames or 0) &gt; 0 then
				item.emergeFrames -= 1
				item.y -= 0.5
			else
				if not item.static then
					item.vy = math.min((item.vy or 0) + 0.22, 5)
					local nextX = item.x + (item.vx or 0)
					if solidAt(level, nextX + (item.vx &gt; 0 and 14 or 1), item.y + 8) then
						item.vx = -(item.vx or 0)
					else
						item.x = nextX
					end
					local nextY = item.y + item.vy
					if item.vy &gt; 0 and (solidAt(level, item.x + 2, nextY + 15) or solidAt(level, item.x + 14, nextY + 15)) then
						local row = math.floor((nextY + 15) / 16)
						item.y = row * 16 - 16
						if item.kind == "star" and (item.bounces or 0) &lt; 4 then
						item.vy = -4.2
						item.bounces = (item.bounces or 0) + 1
					else
						item.vy = 0
					end
				else
					item.y = nextY
				end
			end
			end
			if overlaps(player.x, player.y, PLAYER_WIDTH, playerHeight(player), item.x, item.y, 16, 16) then
				item.alive = false
				local effectText = "1000"
				if item.kind == "mushroom" then
					if player.power == 0 then
						player.power = 1
						player.y -= 16
					end
					self:_award(1000)
				elseif item.kind == "flower" then
					if player.power == 0 then
						player.y -= 16
					end
					player.power = 2
					self:_award(1000)
				elseif item.kind == "star" then
					player.starFrames = 600
					self:_award(1000)
				elseif item.kind == "oneUp" then
					self.state.lives += 1
					effectText = "1UP"
				else
					self:_award(1000)
				end
				self:_syncActiveProfile()
				self:_addEffect(item.x, item.y, effectText)
			end
		end
	end
end

function Game:_updateCoins()
	local level = self.state.level
	local player = self.state.player
	local height = playerHeight(player)
	for _, coin in ipairs(level.coins or {}) do
		if coin.alive ~= false and overlaps(player.x, player.y, PLAYER_WIDTH, height, coin.x, coin.y, 16, 16) then
			coin.alive = false
			local column = math.floor(coin.x / 16) + 1
			local row = math.floor(coin.y / 16) + 1
			if level.map[column] and level.map[column][row] then
				level.map[column][row] = 0
			end
			self:_addCoin()
			self:_addEffect(coin.x, coin.y, "200")
		end
	end
end

function Game:_updateFireballs()
	local level = self.state.level
	for _, fireball in ipairs(self.state.fireballs) do
		if fireball.alive then
			fireball.vy = math.min((fireball.vy or 0) + 0.18, 4)
			local nextX = fireball.x + fireball.vx
			if solidAt(level, nextX + (fireball.vx &gt; 0 and 5 or 1), fireball.y + 5) then
				fireball.alive = false
			else
				fireball.x = nextX
			end
			local nextY = fireball.y + fireball.vy
			if fireball.vy &gt; 0 and solidAt(level, fireball.x + 4, nextY + 8) then
				local row = math.floor((nextY + 8) / 16)
				fireball.y = row * 16 - 8
				fireball.vy = -3.2
				fireball.bounces += 1
				if fireball.bounces &gt; 3 then
					fireball.alive = false
				end
			else
				fireball.y = nextY
			end
			for _, enemy in ipairs(self.state.enemies) do
				if fireball.alive and enemy.alive and enemy.state ~= "pipePlant"
					and enemy.state ~= "falling" and enemy.state ~= "defeated"
					and overlaps(fireball.x, fireball.y, 8, 8, enemy.x, enemy.y, 16, 24) then
					self:_killEnemy(enemy, 200, false, true)
					fireball.alive = false
				end
			end
			if fireball.x &lt; 0 or fireball.x &gt; level.width * 16 then
				fireball.alive = false
			end
		end
	end
end

function Game:_tryWarp()
	local player = self.state.player
	local level = self.state.level
	if not self.buttons.down or not player.onGround then
		return false
	end
	for _, pipe in ipairs(level.pipes or {}) do
		local centered = math.abs((player.x + PLAYER_WIDTH / 2) - (pipe.x + pipe.width / 2)) &lt;= 8
		local standingOnTop = math.abs((player.y + playerHeight(player)) - pipe.y) &lt;= 2
		if pipe.warp and pipe.targetPointer ~= nil and centered and standingOnTop then
			local targetWorld = math.clamp(pipe.targetWorld or self.state.world, 1, 8)
			local targetStage = self.state.stage
			for candidate = 1, 4 do
				if World.getStagePointer(targetWorld, candidate) == pipe.targetPointer then
					targetStage = candidate
					break
				end
			end
			self:_loadStage(targetWorld, targetStage, pipe.targetPointer, pipe.entrancePage or 0, true, nil, true)
			return true
		end
	end
	return false
end

function Game:_updateVines()
	for _, vine in ipairs(self.state.vines or {}) do
		if vine.active and vine.height &lt; vine.maxHeight then
			vine.growthFrames += 1
			if vine.growthFrames &gt;= 2 then
				vine.growthFrames = 0
				vine.height = math.min(vine.height + 1, vine.maxHeight)
			end
		end
	end
end

function Game:_findVineAtPlayer(player)
	local height = playerHeight(player)
	local centerX = player.x + PLAYER_WIDTH / 2
	for index, vine in ipairs(self.state.vines or {}) do
		if vine.active and vine.height &gt;= 8 then
			local topY = vine.bottomY - vine.height
			if math.abs(centerX - vine.x) &lt;= 10 and player.y + height &gt;= topY - 8 and player.y &lt;= vine.bottomY then
				return index, vine
			end
		end
	end
	return nil, nil
end

function Game:_updatePlayer()
	local player = self.state.player
	local level = self.state.level
	local pressed = self.pressed
	if player.autoControl then
		self:_updateAxeVictory(player, level)
		return
	end
	if pressed.pause or pressed.start then
		self.state.mode = "paused"
		return
	end

	self:_updateVines()
	local oldHeight = playerHeight(player)
	local wantsCrouch = self.buttons.down == true and player.power &gt; 0 and player.onGround
		and not player.climbing and not player.autoControl
	if wantsCrouch ~= player.crouching then
		if wantsCrouch then
			player.crouching = true
		elseif not solidAt(level, player.x + 4, player.y - 8) and not solidAt(level, player.x + 9, player.y - 8) then
			player.crouching = false
		end
	end
	local height = playerHeight(player)
	if oldHeight &gt; height then
		player.y += oldHeight - height
	elseif oldHeight &lt; height then
		player.y -= height - oldHeight
	end

	if not player.climbing and not player.autoControl and self.buttons.up then
		local vineIndex, vine = self:_findVineAtPlayer(player)
		if vine then
			player.climbing = true
			player.vineIndex = vineIndex
			player.vx = 0
			player.vy = 0
			player.onGround = false
			player.x = vine.x - PLAYER_WIDTH / 2
		end
	end
	if not player.climbing and not player.autoControl and self:_tryWarp() then
		return
	end
	if self.fireCooldown &gt; 0 then
		self.fireCooldown -= 1
	end
	if not player.climbing and not player.autoControl and self.buttons.run and player.power &gt;= 2 and self.fireCooldown &lt;= 0 then
		self:_spawnFireball()
	end

	local previousBottom = player.y + height
	if player.climbing then
		local vine = self.state.vines[player.vineIndex]
		if not vine or not vine.active then
			player.climbing = false
			player.vineIndex = nil
		else
			local topY = math.max(0, vine.bottomY - vine.height)
			local bottomY = math.max(topY, vine.bottomY - height)
			local climbDirection = (if self.buttons.down then 1 else 0) - (if self.buttons.up then 1 else 0)
			player.x = vine.x - PLAYER_WIDTH / 2
			player.vx = 0
			player.vy = 0
			if pressed.jump then
				player.climbing = false
				player.vineIndex = nil
				player.vy = -3.5
			elseif climbDirection ~= 0 then
				player.y = math.clamp(player.y + climbDirection * 1.25, topY, bottomY)
			end
			if player.climbing and player.y &lt;= topY then
				player.climbing = false
				player.vineIndex = nil
				player.onGround = false
				player.vy = -0.5
			elseif player.climbing and player.y &gt;= bottomY then
				player.climbing = false
				player.vineIndex = nil
			end
		end
	else
		local direction = if player.autoControl then 1
			else (if self.buttons.right then 1 else 0) - (if self.buttons.left then 1 else 0)
		if player.autoControl then
			player.facing = 1
			player.vx = 1.5
		elseif direction ~= 0 then
			player.facing = direction
			local running = self.buttons.run == true
			local maxSpeed = if running then 2.5 else 1.5
			if player.vx * direction &lt; 0 then
				if math.abs(player.vx) &lt;= 11 / 16 then
					player.vx = 0
				else
					player.vx += direction * (if running then 0.11 else 0.075)
				end
			else
				local acceleration = if running then 0.07 else 0.04
				player.vx = math.clamp(player.vx + direction * acceleration, -maxSpeed, maxSpeed)
			end
		elseif player.onGround then
			local friction = 0.056
			if math.abs(player.vx) &lt;= friction then
				player.vx = 0
			else
				player.vx -= if player.vx &gt; 0 then friction else -friction
			end
		end

		if not player.autoControl then
			if player.swimCooldown &gt; 0 then
				player.swimCooldown -= 1
			end
			if pressed.jump and player.onGround then
				player.vy = if level.water then -2 else -4
				player.onGround = false
			elseif pressed.jump and level.water and player.swimCooldown &lt;= 0 then
				player.vy = -2
				player.onGround = false
				player.swimCooldown = 20
			end
		end

		local gravity
		if level.water then
			gravity = if player.vy &lt; 0 and self.buttons.jump then 0.05 else 0.04
		else
			gravity = if player.vy &lt; 0 and self.buttons.jump then 0.125 else 0.4375
		end
		player.vy = math.min(player.vy + gravity, if level.water then 3.5 else 5)
		self:_resolvePlayerMotion(player, player.vx, player.vy)
	end

	if player.starFrames &gt; 0 then
		player.starFrames -= 1
	end
	if player.invulnFrames &gt; 0 then
		player.invulnFrames -= 1
	end
	self:_updateEnemies()
	self:_checkPlayerEnemyCollisions(previousBottom)
	if self.state.mode ~= "playing" then
		return
	end
	self:_updateItems()
	self:_updateCoins()
	self:_updateFireballs()

	for i = #self.state.effects, 1, -1 do
		local effect = self.state.effects[i]
		effect.timer -= 1
		effect.y += effect.vy or 0
		if effect.timer &lt;= 0 then
			table.remove(self.state.effects, i)
		end
	end

	if player.y &gt; 224 then
		self.state.mode = "dying"
		self.transitionFrames = 75
		return
	end
	if level.axeX and not level.axeUsed
		and overlaps(player.x, player.y, PLAYER_WIDTH, playerHeight(player), level.axeX, 6 * 16, 16, 16) then
		self:_activateAxe()
		return
	end
	if level.flagX and player.x + PLAYER_WIDTH &gt;= level.flagX then
		self:_startFlagpole()
		return
	elseif level.castleX and not level.axeX and player.x &gt;= level.castleX + 80 then
		self:_startStageClear()
		return
	elseif not level.axeX and player.x &gt;= level.endX then
		self:_startStageClear()
		return
	end

	local maxCamera = math.max(0, level.width * 16 - 256)
	self.state.cameraX = math.clamp(player.x - 112, 0, maxCamera)
	local halfwayPage = self.state.halfwayPage or 0
	if halfwayPage &gt; 0 and math.floor(self.state.cameraX / 256) &gt;= halfwayPage then
		self.state.checkpointPage = math.max(self.state.checkpointPage or 0, halfwayPage)
	end

	self.timerFrames += 1
	if self.timerFrames &gt;= TIMER_INTERVAL_FRAMES then
		self.timerFrames = 0
		self.state.time = math.max(0, self.state.time - 1)
		if self.state.time == 100 and not self.state.hurryUp then
			self.state.hurryUp = true
		end
		if self.state.time == 0 then
			self.state.mode = "dying"
			self.transitionFrames = 75
		end
	end
	self:_syncActiveProfile()
end

function Game:_tick()
	local state = self.state
	state.frame += 1
	local mode = state.mode

	if mode == "title" then
		if self.pressed.up or self.pressed.down then
			state.menuIndex = if state.menuIndex == 1 then 2 else 1
		end
		if self.pressed.start or self.pressed.jump then
			self:_startNewGame()
		end
	elseif mode == "intro" then
		state.introFrames = (state.introFrames or 0) - 1
		if state.introFrames &lt;= 0 then
			state.mode = "playing"
		end
	elseif mode == "playing" then
		self:_updatePlayer()
	elseif mode == "paused" then
		if self.pressed.pause or self.pressed.start then
			state.mode = "playing"
		end
	elseif mode == "dying" then
		self.transitionFrames -= 1
		if state.player then
			state.player.y += state.player.vy or 0
			state.player.vy = (state.player.vy or 0) + 0.2
		end
		if self.transitionFrames &lt;= 0 then
			self:_loseLife()
		end
	elseif mode == "flagpole" then
		self.flagpoleFrames -= 1
		if state.player then
			state.player.y = math.min(state.player.y + 1.8, 160)
		end
		if self.flagpoleFrames &lt;= 0 then
			self:_startStageClear()
		end
	elseif mode == "stageClear" then
		self.transitionFrames -= 1
		if self.transitionFrames &lt;= 0 then
			self:_advanceStage()
		end
	elseif mode == "gameOver" or mode == "victory" then
		if self.pressed.start then
			self:_startNewGame()
		end
	end

	self.pressed = {}
end

function Game:step(deltaTime)
	self.accumulator = math.min(self.accumulator + math.clamp(deltaTime, 0, 0.25), 0.25)
	local ticks = 0
	while self.accumulator &gt;= STEP and ticks &lt; 8 do
		self:_tick()
		self.accumulator -= STEP
		ticks += 1
	end
end

return Game
</ProtectedString>
